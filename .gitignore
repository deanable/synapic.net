# .NET
bin/
obj/
artifacts/
publish/
*.user
*.suo
*.userosscache
*.sln.docstates
project.lock.json
testresults/
TestResults/
[Ll]ogs/
*.binlog
.dotnet/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build_sidecar/
sidecar_build/
dist/
*.spec.bak
_python

# Sidecar build output
synapic-inference
synapic-inference.exe

# Scratch build logs and working dirs: underscore-prefixed paths under build/
# are per-machine output of the build scripts (build/*.ps1), never source.
build/_*

# Freebuff workspace metadata, written per-clone by the local client
.freebuff/

# IDE
.vs/
.vscode/
.idea/
*.swp

# OS
Thumbs.db
.DS_Store

# Model caches (never commit weights) — anchored so the rule cannot
# swallow source directories named Models/ (e.g. src/Synapic.Main/Models).
/models/
*.safetensors
*.gguf

# Compiled HTML Help output. The sources are committed (docs/help/*.html plus
# the .hhp/.hhc/.hhk); the .chm and the SHA-256 manifest written beside it are
# build artifacts of docs/help/build-chm.ps1, and the app embeds both.
docs/help/*.chm
docs/help/help-payload.json
build/_*.log
UpgradeLog*.htm

# HeatWave's project converter drops a trace log named for the operation
# beside the project it is working on. Per-machine output, same rule as the
# other logs above - seen as untracked noise in build/wix/ after every
# HeatWave install or upgrade.
build/wix/HeatWaveConvert*.log
