<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Shared package versions (spec §5.1) -->
    <AvaloniaVersion>11.1.3</AvaloniaVersion>
    <CommunityToolkitMvvmVersion>8.3.2</CommunityToolkitMvvmVersion>
    <RefitVersion>7.2.22</RefitVersion>
    <MetadataExtractorVersion>2.8.1</MetadataExtractorVersion>
    <NetVipsVersion>2.4.1</NetVipsVersion>
    <SerilogVersion>4.0.2</SerilogVersion>
    <SerilogSinksFileVersion>6.0.0</SerilogSinksFileVersion>
    <XunitVersion>2.9.2</XunitVersion>
  </PropertyGroup>
</Project>
