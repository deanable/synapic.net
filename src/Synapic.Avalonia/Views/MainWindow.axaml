<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Synapic.Avalonia.ViewModels"
        xmlns:vms="using:Synapic.Avalonia.ViewModels.Steps"
        xmlns:steps="using:Synapic.Avalonia.Views.Wizard"
        xmlns:help="using:Synapic.Avalonia.Services"
        x:Class="Synapic.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Synapic — AI Image Tagging"
        Icon="/Assets/Icon.ico"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

    <!-- Toolbar: server controls + status indicator -->
    <Border Grid.Row="0" Classes="card" Padding="10,8" Margin="8"
            help:HelpScope.Topic="first-run-sidecar.html">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Content="Start Server"
                Command="{Binding StartServerCommand}" />
        <Button Content="Stop Server"
                Command="{Binding StopServerCommand}" />
        <Button Content="Build Server"
                Command="{Binding BuildServerCommand}"
                IsVisible="{Binding IsBuildButtonVisible}" />
        <Ellipse Width="12" Height="12" VerticalAlignment="Center"
                 Fill="{Binding ServerBrush}" />
        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                    IsVisible="{Binding IsDownloadVisible}">
          <ProgressBar Value="{Binding DownloadPercent}" Maximum="100"
                       Width="150" Height="6" VerticalAlignment="Center" />
          <TextBlock Text="{Binding DownloadText}" VerticalAlignment="Center" FontSize="11"
                     Opacity="0.85" />
        </StackPanel>
        <TextBlock Text="Synapic — AI-powered image tagging for DAM" Opacity="0.55"
                   VerticalAlignment="Center" Margin="20,0,0,0" />
        <Button Content="Help" Command="{Binding OpenHelpCommand}"
                ToolTip.Tip="Open the Synapic help. F1 opens the topic for what you are looking at." />
      </StackPanel>
    </Border>

    <!-- Sidecar setup: the sidecar is pivotal (nothing can be tagged without
         it), so this panel lists every buildable variant and the workspace
         below stays disabled until at least one exists. -->
    <Border Grid.Row="1" Classes="card" Padding="12,10" Margin="8,0,8,8"
            help:HelpScope.Topic="first-run-sidecar.html"
            IsVisible="{Binding IsSidecarPanelVisible}">
      <StackPanel Orientation="Vertical" Spacing="4">
        <TextBlock Text="Inference sidecar required" FontWeight="SemiBold" FontSize="14"
                   TextWrapping="Wrap" IsVisible="{Binding IsSidecarRequired}" />
        <TextBlock Text="Synapic cannot tag images until a sidecar is ready. Download the prebuilt CPU version (runs anywhere) or the CUDA version (fastest on an NVIDIA GPU), or build it from source if this checkout has the toolchain. The rest of the application stays disabled until one is ready."
                   Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,4"
                   IsVisible="{Binding IsSidecarRequired}" />
        <TextBlock Text="Additional sidecar builds" FontWeight="SemiBold"
                   IsVisible="{Binding !IsSidecarRequired}" />
        <ItemsControl ItemsSource="{Binding SidecarVariants}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SidecarVariantViewModel">
              <StackPanel Orientation="Vertical" Margin="0,3">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                           Fill="{Binding StatusBrush}" />
                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                  <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                             Opacity="0.8" />
                  <TextBlock Text="{Binding Rid}" VerticalAlignment="Center"
                             Opacity="0.45" FontSize="11" />
                  <ProgressBar IsVisible="{Binding IsBusy}"
                               IsIndeterminate="{Binding IsBuildIndeterminate}"
                               Value="{Binding BuildPercent}" Maximum="100"
                               Width="170" Height="6" VerticalAlignment="Center" />
                  <Button Content="Build sidecar" Command="{Binding BuildCommand}"
                          IsVisible="{Binding IsBuildButtonVisible}"
                          ToolTip.Tip="Compile this variant from source; replaces an outdated executable with fresh bytes" />
                  <Button Content="Download" Command="{Binding DownloadCommand}"
                          IsVisible="{Binding IsDownloadButtonVisible}"
                          ToolTip.Tip="Fetch the prebuilt executable from the latest GitHub release instead of compiling it; replaces an outdated executable" />
                  <Button Content="Up to date" IsEnabled="False"
                          IsVisible="{Binding IsUpToDateVisible}"
                          ToolTip.Tip="Nothing to do: this executable matches the source it was built from, and the GitHub release carries nothing newer for it." />
                  <TextBlock Text="{Binding BuildStage}" IsVisible="{Binding IsBusy}"
                             VerticalAlignment="Center" Opacity="0.8" FontSize="11"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Text="{Binding Detail}" Opacity="0.6" FontSize="11"
                           TextWrapping="Wrap" Margin="18,2,0,0" />
                <TextBlock Text="{Binding StaleText}" IsVisible="{Binding IsStale}"
                           Foreground="Goldenrod" FontSize="11" TextWrapping="Wrap"
                           Margin="18,2,0,0" />
                <TextBlock Text="{Binding GitHubUpdateText}" IsVisible="{Binding IsGitHubUpdate}"
                           Foreground="Goldenrod" FontSize="11" TextWrapping="Wrap"
                           Margin="18,2,0,0" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- Wizard nav bar (hidden on the start screen; the route title says which
         workflow owns the steps below) -->
    <Border Grid.Row="2" Classes="card" Padding="10,8" Margin="8,0,8,8"
            IsEnabled="{Binding IsWorkspaceEnabled}"
            IsVisible="{Binding IsWizardVisible}"
            help:HelpScope.Topic="workflow-overview.html">
      <StackPanel Orientation="Vertical" Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="1 · Datasource" Command="{Binding Wizard.BackCommand}"
                  IsVisible="{Binding Wizard.ShowDatasourceTab}" Classes="stepTab" />
          <Button Content="2 · Engine" Command="{Binding Wizard.GoToStep2Command}"
                  IsEnabled="{Binding Wizard.CanGoToStep2Tab}"
                  IsVisible="{Binding Wizard.ShowTaggingTabs}" Classes="stepTab" />
          <Button Content="3 · Process" Command="{Binding Wizard.GoToStep3Command}"
                  IsEnabled="{Binding Wizard.CanGoToStep3Tab}"
                  IsVisible="{Binding Wizard.ShowTaggingTabs}" Classes="stepTab" />
          <Button Content="4 · Results" Command="{Binding Wizard.GoToStep4Command}"
                  IsEnabled="{Binding Wizard.CanGoToStep4Tab}"
                  IsVisible="{Binding Wizard.ShowTaggingTabs}" Classes="stepTab" />
          <Button Content="🧹 Deduplication" Command="{Binding Wizard.GoToDedupCommand}"
                  IsEnabled="{Binding Wizard.CanGoToDedupTab}"
                  IsVisible="{Binding Wizard.ShowDedupTab}" Classes="stepTab"
                  ToolTip.Tip="Scan for duplicates and act on them (local folder or the Step 1 catalog scope)" />
          <Button Content="✨ Upscaling" Command="{Binding Wizard.GoToUpscaleCommand}"
                  IsEnabled="{Binding Wizard.CanGoToUpscaleTab}"
                  IsVisible="{Binding Wizard.ShowUpscaleTab}" Classes="stepTab"
                  ToolTip.Tip="Enhance images with AI upscaling (Swin2SR/Lanczos over the Step 1 source)" />
          <Button Content="↺ Start Over" Command="{Binding Wizard.StartOverCommand}"
                  IsVisible="{Binding Wizard.CanStartOver}" />
          <TextBlock Text="{Binding RouteTitle}" VerticalAlignment="Center" Opacity="0.6"
                     Margin="8,0,0,0" FontStyle="Italic" />
          <Button Content="⌂ Home" Command="{Binding GoHomeCommand}"
                  Margin="8,0,0,0"
                  ToolTip.Tip="Back to the start screen (Tagging / Deduplication / Upscaling)" />
        </StackPanel>
        <TextBlock Classes="validationError" IsVisible="{Binding Wizard.ValidationError}"
                   Text="{Binding Wizard.ValidationError}" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock Grid.Column="0" Text="{Binding Wizard.NavHintText}"
                     VerticalAlignment="Center" Opacity="0.7" />
          <Button Grid.Column="1" Content="← Back" Command="{Binding Wizard.BackCommand}"
                  Margin="0,0,8,0" />
          <Button Grid.Column="2" Content="{Binding Wizard.NextButtonText}"
                  Command="{Binding Wizard.NextCommand}" Classes="accent" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- Body: start screen (route chooser) or the wizard for the chosen route -->
    <Grid Grid.Row="3" Margin="8,0">
      <!-- Start screen: source first, then the workflow. The three route cards
           stay disabled until the source panel has a usable source (a folder
           that exists, or a live Daminion session), so no route can be entered
           without knowing what it would work on. The panel is the wizard's own
           Step 1 view model, so the choice carries into every route. -->
      <ScrollViewer Margin="0" IsVisible="{Binding IsHomeVisible}">
      <StackPanel Spacing="12" Margin="0,20,0,20" help:HelpScope.Topic="workflow-overview.html">
        <StackPanel HorizontalAlignment="Center" Spacing="6">
          <TextBlock Text="What do you want to do?" FontSize="22" FontWeight="SemiBold"
                     HorizontalAlignment="Center" />
          <TextBlock Text="Pick a source first — the three workflows unlock once Synapic knows what to work on."
                     Opacity="0.7" HorizontalAlignment="Center" />
        </StackPanel>

        <Border Classes="card" Padding="14" help:HelpScope.Topic="step1-datasource.html">
          <StackPanel Spacing="10">
            <TextBlock Text="1 · Where are the images?" FontWeight="SemiBold" FontSize="14" />
            <steps:DatasourceSourcePanel DataContext="{Binding Wizard.Step1}" />
          </StackPanel>
        </Border>

        <StackPanel Spacing="6" Margin="0,6,0,0">
          <TextBlock Text="2 · What do you want to do?" FontWeight="SemiBold" FontSize="14"
                     HorizontalAlignment="Center" />
          <TextBlock Text="Choose a folder or connect to Daminion first — the three workflows stay disabled until then."
                     IsVisible="{Binding !CanStartRoute}"
                     Foreground="#B3261E" FontSize="12" TextWrapping="Wrap"
                     HorizontalAlignment="Center" TextAlignment="Center" />
        </StackPanel>

        <UniformGrid Columns="3">
          <Button Classes="routeCard" Command="{Binding StartTaggingRouteCommand}"
                  IsEnabled="{Binding CanStartRoute}"
                  Margin="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
            <StackPanel Spacing="6" Margin="6">
              <TextBlock Text="🏷  Tagging" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="Run the AI model over a datasource: choose the source, the engine and the fields, process the batch, then review what was written."
                         TextWrapping="Wrap" Opacity="0.85" />
              <TextBlock Text="Datasource → Engine → Process → Results" Opacity="0.55" />
            </StackPanel>
          </Button>
          <Button Classes="routeCard" Command="{Binding StartDedupRouteCommand}"
                  IsEnabled="{Binding CanStartRoute}"
                  Margin="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
            <StackPanel Spacing="6" Margin="6">
              <TextBlock Text="🧹  Deduplication" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="Find duplicate images in a local folder or in the Daminion catalog scope, review the groups, then tag, move or delete the extras."
                         TextWrapping="Wrap" Opacity="0.85" />
              <TextBlock Text="Datasource → Deduplication" Opacity="0.55" />
            </StackPanel>
          </Button>
          <Button Classes="routeCard" Command="{Binding StartUpscaleRouteCommand}"
                  IsEnabled="{Binding CanStartRoute}"
                  Margin="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
            <StackPanel Spacing="6" Margin="6">
              <TextBlock Text="✨  Upscaling" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="Enhance image resolution — the Daminion Feature enhancement utility: AI (Swin2SR) or fast Lanczos upscaling over the chosen source."
                         TextWrapping="Wrap" Opacity="0.85" />
              <TextBlock Text="Datasource → Upscaling" Opacity="0.55" />
            </StackPanel>
          </Button>
        </UniformGrid>
      </StackPanel>
      </ScrollViewer>

      <ScrollViewer Margin="0" IsEnabled="{Binding IsWorkspaceEnabled}"
                    IsVisible="{Binding IsWizardVisible}">
        <ContentControl Content="{Binding Wizard.CurrentStep}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="vms:Step1DatasourceViewModel">
              <steps:Step1Datasource />
            </DataTemplate>
            <DataTemplate DataType="vms:Step2EngineViewModel">
              <steps:Step2Engine />
            </DataTemplate>
            <DataTemplate DataType="vms:Step3ProcessViewModel">
              <steps:Step3Process />
            </DataTemplate>
            <DataTemplate DataType="vms:Step4ResultsViewModel">
              <steps:Step4Results />
            </DataTemplate>
            <DataTemplate DataType="vms:StepDedupViewModel">
              <steps:StepDedup />
            </DataTemplate>
            <DataTemplate DataType="vms:StepUpscaleViewModel">
              <steps:StepUpscale />
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
      </ScrollViewer>
    </Grid>

    <!-- Live log -->
    <Border Grid.Row="4" Classes="card" Height="160" Margin="8"
            help:HelpScope.Topic="step3-log.html">
      <Grid RowDefinitions="Auto,*" Margin="8">
        <TextBlock Grid.Row="0" Text="Log" FontWeight="SemiBold" />
        <ListBox Grid.Row="1" ItemsSource="{Binding LogEntries}" x:Name="LogList"
                 Margin="0,4,0,0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding RenderedMessage}" FontFamily="Consolas,monospace" FontSize="11"
                         TextWrapping="Wrap" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

  </Grid>

  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SystemRegionBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="BoxShadow" Value="0 1 4 0 #22000000" />
    </Style>
    <Style Selector="Button.stepTab">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <!-- Start-screen route cards: two equal, tall, self-describing choices. -->
    <Style Selector="Button.routeCard">
      <Setter Property="Padding" Value="18" />
      <Setter Property="MinHeight" Value="150" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Padding" Value="14,4" />
    </Style>
    <Style Selector="TextBlock.validationError">
      <Setter Property="Foreground" Value="#B3261E" />
    </Style>
  </Window.Styles>
</Window>
