<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Synapic.Avalonia.ViewModels.Steps"
             x:Class="Synapic.Avalonia.Views.Wizard.Step1Datasource"
             x:DataType="vm:Step1DatasourceViewModel">

  <StackPanel Spacing="12">
    <TextBlock Text="Step 1 — Datasource" FontSize="22" FontWeight="Bold" />

    <StackPanel Orientation="Horizontal" Spacing="12">
      <RadioButton Content="Local Folder" GroupName="ds" IsChecked="{Binding IsLocalSelected}" />
      <RadioButton Content="Daminion Server" GroupName="ds" IsChecked="{Binding IsDaminionSelected}" />
    </StackPanel>

    <!-- Local panel -->
    <Border IsVisible="{Binding IsLocal}" Classes="card" Padding="14">
      <StackPanel Spacing="8">
        <TextBlock Text="Folder containing images" FontWeight="SemiBold" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Grid.Column="0" Watermark="C:\Pictures or /home/user/pictures"
                   Text="{Binding LocalPath}" />
          <Button Grid.Column="1" Content="Browse…" Click="OnBrowseFolder" />
        </Grid>
        <CheckBox Content="Include subfolders (recursive scan)" IsChecked="{Binding LocalRecursive}" />
      </StackPanel>
    </Border>

    <!-- Daminion panel -->
    <Border IsVisible="{Binding IsDaminion}" Classes="card" Padding="14">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="2*,1*,1*,Auto">
          <TextBox Grid.Column="0" Watermark="Server URL, e.g. http://dam.local/daminion"
                   Text="{Binding DaminionUrl}" />
          <TextBox Grid.Column="1" Watermark="Username" Text="{Binding DaminionUser}" />
          <TextBox Grid.Column="2" Watermark="Password" Text="{Binding DaminionPass}" PasswordChar="*" />
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
            <Button Content="Connect" Command="{Binding ConnectCommand}" Classes="accent" />
            <Button Content="Disconnect" Command="{Binding DisconnectCommand}"
                    IsVisible="{Binding IsDaminionConnected}" />
          </StackPanel>
        </Grid>
        <StackPanel Orientation="Vertical" Spacing="2">
          <TextBox Watermark="Catalog (optional)" Text="{Binding DaminionCatalogId}" MaxWidth="300"
                   HorizontalAlignment="Left" />
          <!-- Daminion exposes no endpoint that lists a server's catalogs, so
               after connecting we report the one the login landed on. -->
          <TextBlock Text="{Binding ActiveCatalogText}"
                     IsVisible="{Binding HasActiveCatalog}"
                     Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                     ToolTip.Tip="The catalog this login is bound to. Daminion has no API to list a server's catalogs, so this reports the one in use." />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <ProgressBar IsIndeterminate="True" Width="90" Height="6"
                       IsVisible="{Binding IsConnecting}" />
          <ProgressBar IsIndeterminate="True" Width="90" Height="6"
                       IsVisible="{Binding IsLoadingCatalog}" />
          <TextBlock Text="{Binding ConnectionMessage}" Opacity="0.85"
                     IsVisible="{Binding ConnectionMessage}" />
        </StackPanel>

        <Separator Margin="0,6" />

        <Grid ColumnDefinitions="*,16,*">
          <!-- Scope column -->
          <StackPanel Grid.Column="0" Spacing="8">
            <TextBlock Text="Scope" FontWeight="SemiBold" />
            <ComboBox SelectedIndex="{Binding ScopeIndex}" ItemsSource="{Binding ScopeOptions}" MinWidth="190" />
            <TextBox Watermark="Search term"
                     IsVisible="{Binding IsSearchScope}"
                     Text="{Binding SearchTerm}" />
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsCollectionScope}">
              <ComboBox ItemsSource="{Binding Collections}"
                        SelectedItem="{Binding SelectedCollection}"
                        DisplayMemberBinding="{Binding Name}"
                        MinWidth="240"
                        IsEnabled="{Binding IsDaminionConnected}" />
              <TextBox Watermark="Collection id (manual)" Text="{Binding CollectionId}" Width="110" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsSavedSearchScope}">
              <ComboBox ItemsSource="{Binding SavedSearches}"
                        SelectedItem="{Binding SelectedSavedSearch}"
                        DisplayMemberBinding="{Binding Name}"
                        MinWidth="240"
                        IsEnabled="{Binding IsDaminionConnected}" />
              <TextBox Watermark="Saved search id (manual)" Text="{Binding SavedSearchId}" Width="110" />
            </StackPanel>
          </StackPanel>

          <!-- Filters column -->
          <StackPanel Grid.Column="2" Spacing="8">
            <TextBlock Text="Filters" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Status:" VerticalAlignment="Center" />
              <ComboBox SelectedIndex="{Binding StatusFilterIndex}"
                        ItemsSource="{Binding StatusFilterOptions}" MinWidth="120" />
            </StackPanel>
            <TextBlock Text="Only items with untagged:" Opacity="0.8" />
            <WrapPanel Orientation="Horizontal">
              <CheckBox Content="Keywords" IsChecked="{Binding UntaggedKeywords}" />
              <CheckBox Content="Categories" IsChecked="{Binding UntaggedCategories}" />
              <CheckBox Content="Description" IsChecked="{Binding UntaggedDescription}" />
            </WrapPanel>
            <Button Content="Select all untagged" Command="{Binding SelectAllUntaggedCommand}"
                    HorizontalAlignment="Left" />
          </StackPanel>
        </Grid>

        <Separator Margin="0,6" />

        <!-- Processing limits + count -->
        <StackPanel Orientation="Horizontal" Spacing="16">
          <TextBlock Text="Max items:" VerticalAlignment="Center" />
          <NumericUpDown Value="{Binding MaxItems}" Minimum="0" Maximum="1000000"
                         Increment="50" Width="120" IsEnabled="{Binding !ProcessAll}" />
          <CheckBox Content="Process all (page until empty)"
                    IsChecked="{Binding ProcessAll}" VerticalAlignment="Center"
                    ToolTip.Tip="Ignore the max-items limit and keep requesting pages until the server returns no more results (use for catalogs larger than one API response)." />
          <TextBlock Text="AI image scale:" VerticalAlignment="Center" />
          <ComboBox SelectedIndex="{Binding ResizeScaleIndex}"
                    ItemsSource="{Binding ResizeScaleOptions}" MinWidth="90" />
          <CheckBox Content="Use fixed 200px thumbnail (fast)"
                    IsChecked="{Binding UseThumbnailOverride}" VerticalAlignment="Center" />
          <Button Content="Count matching items" Command="{Binding CountCommand}" />
          <ProgressBar IsIndeterminate="True" Width="80" Height="6"
                       IsVisible="{Binding IsCounting}" />
          <TextBlock Text="{Binding CountText}" VerticalAlignment="Center" FontWeight="SemiBold"
                     IsVisible="{Binding CountText}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
