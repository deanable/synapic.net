<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Synapic.Avalonia.ViewModels.Steps"
             x:Class="Synapic.Avalonia.Views.Wizard.Step2Engine"
             x:DataType="vm:Step2EngineViewModel">

  <StackPanel Spacing="12">
    <TextBlock Text="Step 2 — Tagging Engine (local Python sidecar)" FontSize="22" FontWeight="Bold" />

    <StackPanel Spacing="10">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Refresh local models" Command="{Binding RefreshModelsCommand}" />
        <Button Content="Download model…" Command="{Binding DownloadSelectedCommand}" />
        <ProgressBar IsIndeterminate="true" Width="80" IsVisible="{Binding IsLoadingModels}" />
        <TextBlock Text="{Binding ModelsMessage}" VerticalAlignment="Center" Opacity="0.7" />
      </StackPanel>

      <ListBox ItemsSource="{Binding LocalModels}" SelectedItem="{Binding SelectedModel}" Height="180">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Id}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Task}" Opacity="0.6" />
              <TextBlock Text="{Binding SizeMb}" Opacity="0.6" />
              <TextBlock Text="✓ downloaded" IsVisible="{Binding Downloaded}" Foreground="Green" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBox Watermark="Model id (Hugging Face repo)" Text="{Binding ManualModelId}" />

      <StackPanel Orientation="Horizontal" Spacing="16">
        <TextBlock Text="Device:" VerticalAlignment="Center" />
        <ComboBox SelectedIndex="{Binding DeviceIndex}" ItemsSource="{Binding DeviceOptions}" MinWidth="100" />
        <TextBlock Text="Task:" VerticalAlignment="Center" />
        <TextBlock Text="Category + Keywords + Description (multimodal)"
                   VerticalAlignment="Center" Opacity="0.7" />
      </StackPanel>

      <!-- Which returned fields to tag; the multimodal prompt always yields all
           three, so this selects the permutation that gets written. -->
      <StackPanel Orientation="Horizontal" Spacing="16">
        <TextBlock Text="Tag fields:" VerticalAlignment="Center" />
        <CheckBox Content="Keywords" IsChecked="{Binding TagKeywords}" />
        <CheckBox Content="Categories" IsChecked="{Binding TagCategories}" />
        <CheckBox Content="Description" IsChecked="{Binding TagDescription}" />
        <TextBlock Text="Select at least one field to continue"
                   IsVisible="{Binding HasNoTagFieldSelected}"
                   Foreground="Red" VerticalAlignment="Center" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="16">
        <TextBlock Text="Confidence threshold:" VerticalAlignment="Center" />
        <NumericUpDown Value="{Binding ConfidenceThreshold}" Minimum="0" Maximum="1" Increment="0.05" Width="110" />
        <TextBlock Text="Probability mode:" VerticalAlignment="Center" />
        <ComboBox SelectedIndex="{Binding ProbabilityModeIndex}" ItemsSource="{Binding ProbabilityModeOptions}" MinWidth="130" />
        <TextBlock Text="Prob. threshold:" VerticalAlignment="Center" />
        <NumericUpDown Value="{Binding ProbabilityThreshold}" Minimum="0" Maximum="1" Increment="0.05" Width="110" />
      </StackPanel>

      <TextBox Watermark="Candidate labels (comma-separated, for probability/zero-shot)"
               Text="{Binding ProbabilityCandidates}" />
      <TextBlock Text="System prompt (optional VLM context)"
                 FontWeight="SemiBold" Margin="0,4,0,0" />
      <TextBlock TextWrapping="Wrap" Opacity="0.75"
                 Text="Every system prompt you commit is remembered below, so previous wording stays one click away." />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ComboBox x:Name="SystemPromptPresetBox"
                  ItemsSource="{Binding SystemPromptPresets}"
                  SelectedItem="{Binding SelectedSystemPromptPreset}"
                  MinWidth="260" MaxDropDownHeight="260"
                  PlaceholderText="Saved system prompts" />
        <TextBlock Text="Highlight an entry and press Delete to remove it from the saved list"
                   VerticalAlignment="Center" Opacity="0.75" TextWrapping="Wrap" />
      </StackPanel>
      <TextBox x:Name="SystemPromptBox"
               Watermark="Custom system prompt (VLM) - optional context, must not restate the output format"
               Text="{Binding SystemPrompt}"
               AcceptsReturn="True" Height="60" />
      <TextBlock Text="{Binding SystemPromptMessage}" TextWrapping="Wrap" Opacity="0.75" />

      <TextBlock Text="Tag instruction (sent to the model for every image)"
                 FontWeight="SemiBold" Margin="0,4,0,0" />
      <TextBlock TextWrapping="Wrap" Opacity="0.75"
                 Text="Leave blank to use the built-in instruction, which asks for a JSON object with description, category and keywords. A custom instruction must keep asking for that JSON shape - the app reads those three fields out of the reply, and anything else is stored as a plain-text description." />
      <TextBox x:Name="UserPromptBox" Text="{Binding UserPrompt}" AcceptsReturn="True" Height="110"
               TextWrapping="Wrap"
               Watermark="Blank = built-in instruction" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="UseBuiltInPromptButton" Content="Use built-in instruction"
                Command="{Binding UseBuiltInPromptCommand}" />
        <Button x:Name="ResetUserPromptButton" Content="Reset to built-in"
                Command="{Binding ResetUserPromptCommand}" />
        <TextBlock Text="Using a custom instruction" VerticalAlignment="Center"
                   Foreground="DarkOrange" IsVisible="{Binding HasCustomUserPrompt}" />
      </StackPanel>
      <TextBlock Text="{Binding PromptMessage}" TextWrapping="Wrap" Opacity="0.75" />
    </StackPanel>
  </StackPanel>
</UserControl>
