<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Synapic.Avalonia.Views.CrashDialogWindow"
        Title="Synapic — Something went wrong"
        Width="560" Height="420"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">

    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
      <TextBlock Text="⚠" FontSize="26" VerticalAlignment="Center" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Synapic hit an unexpected problem" FontWeight="Bold" FontSize="15" />
        <TextBlock Text="The details below were saved to the crashes folder. Nothing was sent anywhere."
                   Opacity="0.75" FontSize="12" />
      </StackPanel>
    </StackPanel>

    <TextBlock Grid.Row="1" Text="{Binding Headline}" FontWeight="SemiBold"
               TextWrapping="Wrap" Margin="0,0,0,8" />

    <Border Grid.Row="2" Classes="card" Padding="8">
      <TextBox Text="{Binding Diagnostics}"
               IsReadOnly="True"
               TextWrapping="Wrap"
               FontSize="11"
               AcceptsReturn="True" />
    </Border>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Copy diagnostics" Command="{Binding CopyCommand}" />
      <Button Content="Open crashes folder" Command="{Binding OpenFolderCommand}" />
      <Button Content="Continue" Classes="accent" Command="{Binding ContinueCommand}" />
    </StackPanel>

  </Grid>
</Window>
