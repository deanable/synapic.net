<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Headless Synapic engine (sidecar host, inference client, metadata writing, Daminion access, tagging kernel). No UI framework reference: consumed by the desktop app and the Windows indexer service.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MetadataExtractor" Version="$(MetadataExtractorVersion)" />
    <PackageReference Include="NetVips" Version="$(NetVipsVersion)" />
    <PackageReference Include="NetVips.Native" Version="8.18.6" />
    <PackageReference Include="Refit" Version="$(RefitVersion)" />
    <PackageReference Include="Serilog" Version="$(SerilogVersion)" />
    <PackageReference Include="Serilog.Sinks.File" Version="$(SerilogSinksFileVersion)" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Synapic.Core.Tests" />
    <InternalsVisibleTo Include="Synapic.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Synapic.Shared\Synapic.Shared.csproj" />
  </ItemGroup>

</Project>
