<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Synapic.Main.App"
             RequestedThemeVariant="Default">

  <Application.Styles>
    <FluentTheme />

    <!-- ═══════════════════════════════════════════════════════════════════
         Shared control styles for the redesigned shell. They live on the
         Application rather than on MainWindow so a dialog (the engine
         settings modal) and any future window get the same look without
         re-declaring them.
         ═══════════════════════════════════════════════════════════════ -->

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SystemRegionBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="BoxShadow" Value="0 1 4 0 #22000000" />
    </Style>

    <!-- Start-screen route cards: three equal, tall, self-describing choices. -->
    <Style Selector="Button.routeCard">
      <Setter Property="Padding" Value="18" />
      <Setter Property="MinHeight" Value="150" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <!-- Primary action (proposal §5.2: one obvious primary action per view). -->
    <Style Selector="Button.accent">
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{DynamicResource SynapicAccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.accent /template/ ContentPresenter">
      <Setter Property="TextElement.Foreground" Value="White" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SynapicAccentHoverBrush}" />
    </Style>

    <Style Selector="TextBlock.validationError">
      <Setter Property="Foreground" Value="{DynamicResource SynapicDangerBrush}" />
    </Style>

    <!-- ── Type and row rhythm ──────────────────────────────────────────────
         One title per page, one heading per section, one label style for the
         inline "Label: [control]" rows. The settings rows in this app are
         deliberately short; the wrapping ones below carry the "wrap instead of
         clip" rule, so a row that fits at 1280 cannot push its last control out
         of the card at 1024. -->
    <Style Selector="TextBlock.stepTitle">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- A settings row: children wrap onto the next line instead of running off
         the card. Child spacing lives on the children (Avalonia's WrapPanel has
         no Spacing of its own). -->
    <Style Selector="WrapPanel.settingsRow">
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="Border.settingsCard">
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- The numbered sidebar's styles (navItem / navItem.active / navMode /
         navGroup) went with the sidebar itself: navigation is Dashboard ⇄
         operation now, and the mode's own entry is the dashboard panel. A
         re-introduced sidebar entry would need its styling back, which is the
         point — this phase deletes the chrome rather than hiding it. -->
  </Application.Styles>

  <Application.Resources>
    <Thickness x:Key="CardPadding">16</Thickness>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>

    <!-- ═══════════════════════════════════════════════════════════════════
         Palette (proposal §6.4). These are *semantic* colours, so they are
         fixed rather than theme-dependent: an accent that changes with the
         theme stops being recognisable as "the primary action".
         Surfaces, borders and text keep using Fluent's theme brushes so
         light, dark and High Contrast keep working — the proposal's literal
         gray-100/gray-900 table would have hard-coded a light UI.
         ═══════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="SynapicAccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="SynapicAccentHoverBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="SynapicSuccessBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="SynapicDangerBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="SynapicWarningBrush" Color="#EA580C" />
  </Application.Resources>

</Application>
