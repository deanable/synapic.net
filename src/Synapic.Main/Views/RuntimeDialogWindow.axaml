<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Synapic.Avalonia.Views.RuntimeDialogWindow"
        Title="Synapic — .NET runtime needed"
        Icon="/Assets/Icon.ico"
        Width="560" Height="340"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">

    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
      <TextBlock Text="⚠" FontSize="26" VerticalAlignment="Center" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding Heading}" FontWeight="Bold" FontSize="15" />
        <TextBlock Text="{Binding Headline}" TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
      </StackPanel>
    </StackPanel>

    <TextBlock Grid.Row="1" Text="{Binding Detail}" TextWrapping="Wrap"
               FontWeight="SemiBold" Margin="0,0,0,8" />

    <Border Grid.Row="2" Classes="card" Padding="8" VerticalAlignment="Top">
      <StackPanel Spacing="6">
        <TextBlock Text="Official download page" FontWeight="SemiBold" FontSize="12" />
        <TextBox Text="{Binding DownloadUrl}" IsReadOnly="True" FontSize="12" />
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Copy link" Command="{Binding CopyLinkCommand}" />
      <Button Content="Continue" Command="{Binding ContinueCommand}" />
      <Button Content="{Binding DownloadLabel}" Classes="accent" Command="{Binding OpenDownloadCommand}" />
    </StackPanel>

  </Grid>
</Window>
