<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Synapic.Main.ViewModels"
             xmlns:vms="using:Synapic.Main.ViewModels.Steps"
             xmlns:steps="using:Synapic.Main.Views.Wizard"
             xmlns:help="using:Synapic.Main.Services"
             x:Class="Synapic.Main.Views.MainLayout"
             x:DataType="vm:MainWindowViewModel">

  <!-- The shell (proposal §2.1): a persistent header carrying the source, a
       sidebar that is the navigation, the content area, and a footer that owns
       the server controls. The log stays a fixed strip at the bottom - §4.5
       requires the log view to survive the redesign. -->
  <Grid RowDefinitions="Auto,*,Auto,Auto">

    <!-- ═══════════════ Header: source selector, always on screen ═════════ -->
    <Border Grid.Row="0" Classes="card" Padding="12,8" Margin="8,8,4,0"
            help:HelpScope.Topic="workflow-overview.html">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
          <TextBlock Text="Source" FontWeight="SemiBold" Opacity="0.65"
                     VerticalAlignment="Center" />
          <!-- Read-only profile of the chosen source: both lights and the
               folder/server line, the same widget Step 1 reports with. It has
               no inputs, so the connect form stays on the start screen only. -->
          <steps:SourceStatusStrip DataContext="{Binding Wizard.Step1}" />
        </StackPanel>

        <TextBlock Grid.Column="1" Text="{Binding Wizard.Step1.CountText}"
                   IsVisible="{Binding Wizard.Step1.CountText}"
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   FontWeight="SemiBold" FontSize="12" Opacity="0.85"
                   ToolTip.Tip="Records the current source would be worked on." />

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Content="⚙ Settings" Command="{Binding OpenSettingsCommand}"
                  ToolTip.Tip="Engine settings: model, device, tag fields, thresholds and prompts" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ═══════════════ Sidebar: the navigation (proposal §2.2.2) ═════════ -->
    <Border Grid.Row="1" Grid.Column="0" Classes="card" Padding="8" Margin="8,4,0,4"
            Width="214"
            help:HelpScope.Topic="workflow-overview.html">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="2">

          <Button Classes="navItem" Content="🏠  Dashboard"
                  Command="{Binding GoHomeCommand}"
                  IsVisible="{Binding IsWizardVisible}"
                  ToolTip.Tip="Back to the start screen (Tagging / Deduplication / Upscaling)" />

          <!-- Source is shared by all three flows (proposal §2.2.2), so it is
               one group rather than a copy inside each mode. -->
          <TextBlock Classes="navGroup" Text="SOURCE"
                     IsVisible="{Binding IsWizardVisible}" />
          <StackPanel IsVisible="{Binding IsWizardVisible}"
                      IsEnabled="{Binding IsWorkspaceEnabled}">
            <Button Classes="navItem" Content="1 · Datasource"
                    Command="{Binding Wizard.GoToStep1Command}"
                    Classes.active="{Binding Wizard.IsSourceStepActive}"
                    ToolTip.Tip="Which images this run works on" />
          </StackPanel>

          <!-- ── Tagging ─────────────────────────────────────────────────── -->
          <Button Classes="navMode" Content="🏷  Tagging"
                  Command="{Binding StartTaggingRouteCommand}"
                  IsEnabled="{Binding CanStartRoute}"
                  ToolTip.Tip="Run the AI model over the source" />
          <StackPanel IsVisible="{Binding IsWizardVisible}"
                      IsEnabled="{Binding IsWorkspaceEnabled}">
            <Button Classes="navItem" Content="2 · Engine"
                    Command="{Binding Wizard.GoToStep2Command}"
                    IsEnabled="{Binding Wizard.CanGoToStep2Tab}"
                    IsVisible="{Binding Wizard.ShowTaggingTabs}"
                    Classes.active="{Binding Wizard.IsEngineStepActive}" />
            <Button Classes="navItem" Content="3 · Process"
                    Command="{Binding Wizard.GoToStep3Command}"
                    IsEnabled="{Binding Wizard.CanGoToStep3Tab}"
                    IsVisible="{Binding Wizard.ShowTaggingTabs}"
                    Classes.active="{Binding Wizard.IsProcessStepActive}" />
            <Button Classes="navItem" Content="4 · Results"
                    Command="{Binding Wizard.GoToStep4Command}"
                    IsEnabled="{Binding Wizard.CanGoToStep4Tab}"
                    IsVisible="{Binding Wizard.ShowTaggingTabs}"
                    Classes.active="{Binding Wizard.IsResultsStepActive}" />
          </StackPanel>

          <!-- ── Deduplication ───────────────────────────────────────────── -->
          <Button Classes="navMode" Content="🧹  Dedup"
                  Command="{Binding StartDedupRouteCommand}"
                  IsEnabled="{Binding CanStartRoute}"
                  ToolTip.Tip="Find duplicates in the source and act on them" />
          <StackPanel IsVisible="{Binding IsWizardVisible}"
                      IsEnabled="{Binding IsWorkspaceEnabled}">
            <Button Classes="navItem" Content="🧹 Deduplication"
                    Command="{Binding Wizard.GoToDedupCommand}"
                    IsEnabled="{Binding Wizard.CanGoToDedupTab}"
                    IsVisible="{Binding Wizard.ShowDedupTab}"
                    Classes.active="{Binding Wizard.IsDedupStepActive}" />
          </StackPanel>

          <!-- ── Upscaling ───────────────────────────────────────────────── -->
          <Button Classes="navMode" Content="✨  Upscale"
                  Command="{Binding StartUpscaleRouteCommand}"
                  IsEnabled="{Binding CanStartRoute}"
                  ToolTip.Tip="Enhance image resolution over the source (Feature enhancement)" />
          <StackPanel IsVisible="{Binding IsWizardVisible}"
                      IsEnabled="{Binding IsWorkspaceEnabled}">
            <Button Classes="navItem" Content="✨ Upscaling"
                    Command="{Binding Wizard.GoToUpscaleCommand}"
                    IsEnabled="{Binding Wizard.CanGoToUpscaleTab}"
                    IsVisible="{Binding Wizard.ShowUpscaleTab}"
                    Classes.active="{Binding Wizard.IsUpscaleStepActive}" />
          </StackPanel>

        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- ═══════════════ Content area ═══════════════ -->
    <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="4,4,8,4">

      <!-- Sidecar setup: the sidecar is pivotal (nothing can be tagged without
           it), so this panel lists every buildable variant and the workspace
           stays disabled until at least one exists. -->
      <Border Grid.Row="0" Classes="card" Padding="12,10" Margin="0,0,0,4"
              help:HelpScope.Topic="first-run-sidecar.html"
              IsVisible="{Binding IsSidecarPanelVisible}">
        <StackPanel Orientation="Vertical" Spacing="4">
          <TextBlock Text="Inference sidecar required" FontWeight="SemiBold" FontSize="14"
                     TextWrapping="Wrap" IsVisible="{Binding IsSidecarRequired}" />
          <TextBlock Text="Synapic cannot tag images until a sidecar is ready. Download the prebuilt CPU version (runs anywhere) or the CUDA version (fastest on an NVIDIA GPU), or build it from source if this checkout has the toolchain. The rest of the application stays disabled until one is ready."
                     Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,4"
                     IsVisible="{Binding IsSidecarRequired}" />
          <TextBlock Text="Additional sidecar builds" FontWeight="SemiBold"
                     IsVisible="{Binding !IsSidecarRequired}" />
          <ItemsControl ItemsSource="{Binding SidecarVariants}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SidecarVariantViewModel">
                <StackPanel Orientation="Vertical" Margin="0,3">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                             Fill="{Binding StatusBrush}" />
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                               Opacity="0.8" />
                    <TextBlock Text="{Binding Rid}" VerticalAlignment="Center"
                               Opacity="0.45" FontSize="11" />
                    <ProgressBar IsVisible="{Binding IsBusy}"
                                 IsIndeterminate="{Binding IsBuildIndeterminate}"
                                 Value="{Binding BuildPercent}" Maximum="100"
                                 Width="170" Height="6" VerticalAlignment="Center" />
                    <Button Content="Build sidecar" Command="{Binding BuildCommand}"
                            IsVisible="{Binding IsBuildButtonVisible}"
                            ToolTip.Tip="Compile this variant from source; replaces an outdated executable with fresh bytes" />
                    <Button Content="Download" Command="{Binding DownloadCommand}"
                            IsVisible="{Binding IsDownloadButtonVisible}"
                            ToolTip.Tip="Fetch the prebuilt executable from the latest GitHub release instead of compiling it; replaces an outdated executable" />
                    <Button Content="Up to date" IsEnabled="False"
                            IsVisible="{Binding IsUpToDateVisible}"
                            ToolTip.Tip="Nothing to do: this executable matches the source it was built from, and the GitHub release carries nothing newer for it." />
                    <TextBlock Text="{Binding BuildStage}" IsVisible="{Binding IsBusy}"
                               VerticalAlignment="Center" Opacity="0.8" FontSize="11"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Text="{Binding Detail}" Opacity="0.6" FontSize="11"
                             TextWrapping="Wrap" Margin="18,2,0,0" />
                  <TextBlock Text="{Binding StaleText}" IsVisible="{Binding IsStale}"
                             Foreground="{DynamicResource SynapicWarningBrush}"
                             FontSize="11" TextWrapping="Wrap" Margin="18,2,0,0" />
                  <TextBlock Text="{Binding GitHubUpdateText}" IsVisible="{Binding IsGitHubUpdate}"
                             Foreground="{DynamicResource SynapicWarningBrush}"
                             FontSize="11" TextWrapping="Wrap" Margin="18,2,0,0" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Body: start screen (mode chooser) or the flow for the chosen mode -->
      <Grid Grid.Row="1">
        <!-- Start screen: source first, then the workflow. The three route cards
             stay disabled until the source panel has a usable source (a folder
             that exists, or a live Daminion session), so no route can be entered
             without knowing what it would work on. The panel is the wizard's own
             Step 1 view model, so the choice carries into every route. -->
        <ScrollViewer IsVisible="{Binding IsHomeVisible}">
          <StackPanel Spacing="12" Margin="0,20,0,20" help:HelpScope.Topic="workflow-overview.html">
            <StackPanel HorizontalAlignment="Center" Spacing="6">
              <TextBlock Text="What do you want to do?" FontSize="22" FontWeight="SemiBold"
                         HorizontalAlignment="Center" />
              <TextBlock Text="Pick a source first — the three workflows unlock once Synapic knows what to work on."
                         Opacity="0.7" HorizontalAlignment="Center" />
            </StackPanel>

            <Border Classes="card" Padding="14" help:HelpScope.Topic="step1-datasource.html">
              <StackPanel Spacing="10">
                <TextBlock Text="1 · Where are the images?" FontWeight="SemiBold" FontSize="14" />
                <steps:DatasourceSourcePanel DataContext="{Binding Wizard.Step1}" />
              </StackPanel>
            </Border>

            <StackPanel Spacing="6" Margin="0,6,0,0">
              <TextBlock Text="2 · What do you want to do?" FontWeight="SemiBold" FontSize="14"
                         HorizontalAlignment="Center" />
              <TextBlock Text="Choose a folder or connect to Daminion first — the three workflows stay disabled until then."
                         IsVisible="{Binding !CanStartRoute}"
                         Foreground="{DynamicResource SynapicDangerBrush}" FontSize="12"
                         TextWrapping="Wrap"
                         HorizontalAlignment="Center" TextAlignment="Center" />
            </StackPanel>

            <UniformGrid Columns="3">
              <Button Classes="routeCard" Command="{Binding StartTaggingRouteCommand}"
                      IsEnabled="{Binding CanStartRoute}"
                      Margin="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                <StackPanel Spacing="6" Margin="6">
                  <TextBlock Text="🏷  Tagging" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="Run the AI model over a datasource: choose the source, the engine and the fields, process the batch, then review what was written."
                             TextWrapping="Wrap" Opacity="0.85" />
                  <TextBlock Text="Datasource → Engine → Process → Results" Opacity="0.55" />
                </StackPanel>
              </Button>
              <Button Classes="routeCard" Command="{Binding StartDedupRouteCommand}"
                      IsEnabled="{Binding CanStartRoute}"
                      Margin="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                <StackPanel Spacing="6" Margin="6">
                  <TextBlock Text="🧹  Deduplication" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="Find duplicate images in a local folder or in the Daminion catalog scope, review the groups, then tag, move or delete the extras."
                             TextWrapping="Wrap" Opacity="0.85" />
                  <TextBlock Text="Datasource → Deduplication" Opacity="0.55" />
                </StackPanel>
              </Button>
              <Button Classes="routeCard" Command="{Binding StartUpscaleRouteCommand}"
                      IsEnabled="{Binding CanStartRoute}"
                      Margin="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                <StackPanel Spacing="6" Margin="6">
                  <TextBlock Text="✨  Upscaling" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="Enhance image resolution — the Daminion Feature enhancement utility: AI (Swin2SR) or fast Lanczos upscaling over the chosen source."
                             TextWrapping="Wrap" Opacity="0.85" />
                  <TextBlock Text="Datasource → Upscaling" Opacity="0.55" />
                </StackPanel>
              </Button>
            </UniformGrid>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer IsEnabled="{Binding IsWorkspaceEnabled}"
                      IsVisible="{Binding IsWizardVisible}">
          <ContentControl Content="{Binding Wizard.CurrentStep}">
            <ContentControl.DataTemplates>
              <DataTemplate DataType="vms:Step1DatasourceViewModel">
                <steps:Step1Datasource />
              </DataTemplate>
              <DataTemplate DataType="vms:Step2EngineViewModel">
                <steps:Step2Engine />
              </DataTemplate>
              <DataTemplate DataType="vms:Step3ProcessViewModel">
                <steps:Step3Process />
              </DataTemplate>
              <DataTemplate DataType="vms:Step4ResultsViewModel">
                <steps:Step4Results />
              </DataTemplate>
              <DataTemplate DataType="vms:StepDedupViewModel">
                <steps:StepDedup />
              </DataTemplate>
              <DataTemplate DataType="vms:StepUpscaleViewModel">
                <steps:StepUpscale />
              </DataTemplate>
            </ContentControl.DataTemplates>
          </ContentControl>
        </ScrollViewer>
      </Grid>

      <!-- Action bar: the forward/back pair the sidebar cannot carry, plus the
           validation message and the processing lock hint that used to sit in
           the old top nav row. -->
      <Border Grid.Row="2" Classes="card" Padding="10,8" Margin="0,4,0,0"
              IsVisible="{Binding IsWizardVisible}"
              IsEnabled="{Binding IsWorkspaceEnabled}"
              help:HelpScope.Topic="workflow-overview.html">
        <StackPanel Orientation="Vertical" Spacing="6">
          <TextBlock Classes="validationError" IsVisible="{Binding Wizard.ValidationError}"
                     Text="{Binding Wizard.ValidationError}" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto,Auto,Auto">
            <TextBlock Grid.Column="0" Text="{Binding Wizard.NavHintText}"
                       VerticalAlignment="Center" Opacity="0.7" />
            <Button Grid.Column="1" Content="↺ Start Over"
                    Command="{Binding Wizard.StartOverCommand}"
                    IsVisible="{Binding Wizard.CanStartOver}"
                    Margin="0,0,8,0"
                    ToolTip.Tip="Back to Step 1 with the statistics reset" />
            <Button Grid.Column="2" Content="← Back" Command="{Binding Wizard.BackCommand}"
                    Margin="0,0,8,0" />
            <Button Grid.Column="3" Content="{Binding Wizard.NextButtonText}"
                    Command="{Binding Wizard.NextCommand}" Classes="accent" />
          </Grid>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ═══════════════ Footer: server status and actions (§3.4) ══════════ -->
    <!-- Annotated with the sidecar topic on purpose: this is where the
         server's Start/Stop/Build controls live now, so F1 from any of them
         opens the sidecar topic. -->
    <Border Grid.Row="2" Classes="card" Padding="10,8" Margin="8,4,8,0"
            help:HelpScope.Topic="first-run-sidecar.html">
      <StackPanel Orientation="Vertical" Spacing="4">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
            <Button Content="Start Server" Command="{Binding StartServerCommand}" />
            <Button Content="Stop Server" Command="{Binding StopServerCommand}" />
            <Button Content="Build Server" Command="{Binding BuildServerCommand}"
                    IsVisible="{Binding IsBuildButtonVisible}" />
            <Ellipse Width="12" Height="12" VerticalAlignment="Center"
                     Fill="{Binding ServerBrush}" />
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                       FontWeight="SemiBold" />
            <!-- The device /health reports for the loaded model: a silent CPU
                 fallback is exactly what this makes visible. -->
            <TextBlock Text="{Binding ServerDeviceText}"
                       IsVisible="{Binding IsServerDeviceVisible}"
                       VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                       Opacity="0.75"
                       ToolTip.Tip="Compute device the inference server reports for the loaded model." />
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                        IsVisible="{Binding IsDownloadVisible}">
              <ProgressBar Value="{Binding DownloadPercent}" Maximum="100"
                           Width="150" Height="6" VerticalAlignment="Center" />
              <TextBlock Text="{Binding DownloadText}" VerticalAlignment="Center" FontSize="11"
                         Opacity="0.85" />
            </StackPanel>
          </StackPanel>
          <Button Grid.Column="1" Content="Help" Command="{Binding OpenHelpCommand}"
                  VerticalAlignment="Center"
                  ToolTip.Tip="Open the Synapic help. F1 opens the topic for what you are looking at." />
        </Grid>
        <!-- What the server reports about the device it is really using, when it
             is not the one selected. Silent otherwise. -->
        <TextBlock Text="{Binding DeviceNotice}"
                   IsVisible="{Binding IsDeviceNoticeVisible}"
                   FontSize="11" Foreground="{DynamicResource SynapicWarningBrush}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- ═══════════════ Live log ═══════════════ -->
    <Border Grid.Row="3" Classes="card" Height="160" Margin="8"
            help:HelpScope.Topic="step3-log.html">
      <Grid RowDefinitions="Auto,*" Margin="8">
        <TextBlock Grid.Row="0" Text="Log" FontWeight="SemiBold" />
        <ListBox Grid.Row="1" ItemsSource="{Binding LogEntries}" x:Name="LogList"
                 Margin="0,4,0,0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding RenderedMessage}" FontFamily="Consolas,monospace" FontSize="11"
                         TextWrapping="Wrap" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

  </Grid>
</UserControl>
