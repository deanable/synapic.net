<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Synapic.Main.ViewModels"
             xmlns:vms="using:Synapic.Main.ViewModels.Steps"
             xmlns:op="using:Synapic.Main.Views.Operation"
             xmlns:steps="using:Synapic.Main.Views.Wizard"
             xmlns:help="using:Synapic.Main.Services"
             x:Class="Synapic.Main.Views.Operation.OperationLayout"
             x:Name="OperationLayoutRoot"
             x:DataType="vm:ViewModelBase">

  <!-- One view for every processing operation (docs/mock-up/Mockup.svg, the three
       rows after Settings): the app's configuration lives on the Settings view, so
       a processing view carries only what a run needs and what it produced —

         · Working on   — the shared source's read-only profile, and the scope,
                          filters and record count the run works on (D10: a scope
                          is a run's choice, so it is made here).
         · Output       — the shared run bar, which is the one run surface, and the
                          operation's report where it has one.

       The slots are handed in by the host (MainLayout.axaml.cs) because a binding
       written on this element resolves against the element's own DataContext,
       which is not the shell:
         SharedSource → the read-only source summary
         Run, Report  → the output region
       The regions stack in one column, which is the narrow-window form: it keeps
       the reading order at every width and never clips a dense parameter row. -->
  <StackPanel Spacing="12" Classes="operationLayout">

    <!-- ── Working on: the shared source, read-only ───────────────────────── -->
    <!-- The one shared source (D4), passed in by the host and rendered by the
         same read-only strip on every route. It has no inputs: the source and
         everything else about it are configured on the Settings view, so there is
         exactly one place to change them. -->
    <Border Classes="card settingsCard sourceSummaryRegion" Padding="16"
            help:HelpScope.Topic="workflow-overview.html">
      <StackPanel Spacing="6">
        <TextBlock Classes="sectionTitle" Text="Working on" />
        <ContentControl x:Name="SourceSummaryHost"
                        Content="{Binding #OperationLayoutRoot.SharedSource}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="vms:Step1DatasourceViewModel">
              <steps:SourceStatusStrip />
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>

        <!-- The scope the run works on: one shared selection, chosen where the run
             happens (D10). The same view model instance the Settings view's Data
             source form binds, so it is a second surface, not a second setting. -->
        <op:ScopeSelectionPanel DataContext="{Binding #OperationLayoutRoot.SharedSource}" />

        <TextBlock Classes="hint" TextWrapping="Wrap"
                   Text="The folder or server the images come from, and the model and every rule, are set on the Settings view — this view runs with what is set there, on the scope chosen above." />
      </StackPanel>
    </Border>

    <!-- ── Output: run bar, the operation's run surface, its report ───────── -->
    <Border Classes="card settingsCard outputRegion" Padding="16"
            help:HelpScope.Topic="workflow-overview.html">
      <StackPanel Spacing="12">
        <TextBlock Classes="sectionTitle" Text="Output" />

        <!-- The shared run bar for the operations that own a run (Phase 1's
             RunStateViewModel): progress, ETA and Stop in one place on every
             operation. An operation with no run renders nothing. -->
        <ContentControl x:Name="RunHost"
                        Content="{Binding #OperationLayoutRoot.Run}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="vms:Step3ProcessViewModel">
              <op:RunStateBar />
            </DataTemplate>
            <DataTemplate DataType="vms:StepDedupViewModel">
              <op:RunStateBar />
            </DataTemplate>
            <DataTemplate DataType="vms:StepUpscaleViewModel">
              <op:RunStateBar />
            </DataTemplate>
            <DataTemplate DataType="vm:ViewModelBase">
              <Panel />
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>

        <!-- The operation's own page, when it has one beyond the run: dedup's
             scan-and-review and upscaling's parameter read-back. Tagging has
             none — its page was a second copy of the run bar (the same progress,
             the same Start, a second log) and is gone, so the bar is the one run
             surface in every mode (D10). -->
        <ContentControl x:Name="RunPageHost"
                        Content="{Binding #OperationLayoutRoot.Run}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="vms:StepDedupViewModel">
              <steps:StepDedup />
            </DataTemplate>
            <DataTemplate DataType="vms:StepUpscaleViewModel">
              <steps:StepUpscale />
            </DataTemplate>
            <DataTemplate DataType="vm:ViewModelBase">
              <Panel />
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>

        <!-- The operation's report, when it has one (tagging: the results grid
             with its export, retry and Daminion verification). -->
        <ContentControl x:Name="ReportHost"
                        Content="{Binding #OperationLayoutRoot.Report}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="vms:Step4ResultsViewModel">
              <steps:Step4Results />
            </DataTemplate>
            <DataTemplate DataType="vm:ViewModelBase">
              <Panel />
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
