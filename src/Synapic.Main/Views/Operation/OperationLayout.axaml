<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Synapic.Main.ViewModels"
             xmlns:vms="using:Synapic.Main.ViewModels.Steps"
             xmlns:op="using:Synapic.Main.Views.Operation"
             xmlns:steps="using:Synapic.Main.Views.Wizard"
             xmlns:help="using:Synapic.Main.Services"
             x:Class="Synapic.Main.Views.Operation.OperationLayout"
             x:DataType="vm:ViewModelBase">

  <!-- One layout for every mode (docs/ui-design.md §2.2/§3, D-01): three regions
       in reading order — what to work on → how to work on it → what happened.
       The DataContext is the mode's current step view model; the layout itself
       knows no mode, it only dispatches its slots to the existing panels and
       pages through DataTemplates. The regions stack in one column, which is the
       narrow-window form of the design: it keeps the reading order at every
       window width and never clips a dense parameter row. -->
  <StackPanel Spacing="12" Classes="operationLayout">

    <!-- ── Region A · Data source (full-width, top of the form) ────────────── -->
    <!-- An empty slot until the shared DataSourceStrip lands (plan 02-02): the
         strip becomes the one place the source is shown and edited, and the
         legacy per-step source panels go away with it. -->
    <Border Classes="card settingsCard dataSourceRegion" Padding="16"
            help:HelpScope.Topic="step1-datasource.html">
      <StackPanel Spacing="8">
        <TextBlock Classes="sectionTitle" Text="Data source" />
        <TextBlock Classes="hint" TextWrapping="Wrap"
                   Text="Local folder or Daminion catalog, its scope and the record count — one source for every operation." />
        <ContentControl x:Name="DataSourceHost" />
      </StackPanel>
    </Border>

    <!-- ── Region B · Parameters ───────────────────────────────────────────── -->
    <Border Classes="card settingsCard parametersRegion" Padding="16"
            help:HelpScope.Topic="settings-reference.html">
      <StackPanel Spacing="8">
        <TextBlock Classes="sectionTitle" Text="Parameters" />
        <TextBlock Classes="hint" TextWrapping="Wrap"
                   Text="The settings this operation runs with." />
        <ContentControl Content="{Binding}">
          <ContentControl.DataTemplates>
            <!-- The dedup and upscale parameter panels, reused verbatim: one view
                 model, one view. Their dialogs stay until Phase 3 retires them.
                 Tagging's engine panel joins them at the same time: it carries
                 the one EngineModelPicker the pinned step-1 test requires to
                 stay unique on screen. -->
            <DataTemplate DataType="vms:StepDedupViewModel">
              <steps:DedupSettingsPanel />
            </DataTemplate>
            <DataTemplate DataType="vms:StepUpscaleViewModel">
              <steps:UpscaleSettingsPanel />
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
      </StackPanel>
    </Border>

    <!-- ── Region C · Output / report ──────────────────────────────────────── -->
    <Border Classes="card settingsCard outputRegion" Padding="16"
            help:HelpScope.Topic="workflow-overview.html">
      <StackPanel Spacing="12">
        <TextBlock Classes="sectionTitle" Text="Output" />

        <!-- The shared run bar for the steps that own a run (Phase 1's
             RunStateViewModel); it renders only for those, so a setup step does
             not grow an empty progress bar. The mode's own page below still
             carries its run controls — this bar is the surface that survives
             Phase 3, which deletes the legacy page. -->
        <ContentControl Content="{Binding}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="vms:Step3ProcessViewModel">
              <op:RunStateBar />
            </DataTemplate>
            <DataTemplate DataType="vms:StepDedupViewModel">
              <op:RunStateBar />
            </DataTemplate>
            <DataTemplate DataType="vms:StepUpscaleViewModel">
              <op:RunStateBar />
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>

        <!-- The mode's existing page, moved in here unchanged: the source panel,
             the settings summary, the run page or the results. Every binding,
             help anchor and pinned test that reads the wizard keeps working;
             Phase 3 deletes the parts the regions above replace. -->
        <ContentControl Content="{Binding}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="vms:Step1DatasourceViewModel">
              <steps:Step1Datasource />
            </DataTemplate>
            <DataTemplate DataType="vms:Step2EngineViewModel">
              <steps:Step2TagSettings />
            </DataTemplate>
            <DataTemplate DataType="vms:Step3ProcessViewModel">
              <steps:Step3Process />
            </DataTemplate>
            <DataTemplate DataType="vms:Step4ResultsViewModel">
              <steps:Step4Results />
            </DataTemplate>
            <DataTemplate DataType="vms:StepDedupViewModel">
              <steps:StepDedup />
            </DataTemplate>
            <DataTemplate DataType="vms:StepUpscaleViewModel">
              <steps:StepUpscale />
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
