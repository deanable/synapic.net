<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Synapic.Main.ViewModels.Steps"
        xmlns:steps="using:Synapic.Main.Views.Wizard"
        xmlns:help="using:Synapic.Main.Services"
        x:Class="Synapic.Main.Views.Settings.DedupSettingsDialog"
        x:DataType="vm:StepDedupViewModel"
        Title="Deduplication Settings"
        Icon="/Assets/Icon.ico"
        Width="720" Height="560"
        MinWidth="560" MinHeight="420"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        help:HelpScope.Topic="dedup.html">

  <!-- 3 · Settings for the deduplication operation: the scan rules and the
       keep-set rule, with the action buttons pinned to the bottom. It hosts the
       wizard's own StepDedup view model, so there is one set of dedup settings
       behind the page and the dialog. -->
  <Grid RowDefinitions="*,Auto">

    <!-- The inset lives on the content (see the tagging settings dialog): a
         ScrollViewer measures at the un-padded width and arranges at the padded
         one, and AllowAutoHide=False keeps the bar in the layout on both. -->
    <ScrollViewer Grid.Row="0" AllowAutoHide="False">
      <steps:DedupSettingsPanel Margin="16,16,16,4" />
    </ScrollViewer>

    <Border Grid.Row="1" Classes="card" Margin="16,8,16,16" Padding="12,10">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0"
                   Text="These rules apply the moment you change them; the review page reports them back before the scan."
                   VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap"
                   Margin="0,0,8,0" />
        <Button Grid.Column="1" Content="Close" Click="OnClose" MinWidth="90" />
      </Grid>
    </Border>

  </Grid>
</Window>
