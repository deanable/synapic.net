<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Synapic.Main.ViewModels"
             xmlns:steps="using:Synapic.Main.Views.Wizard"
             xmlns:op="using:Synapic.Main.Views.Operation"
             xmlns:settings="using:Synapic.Main.Views.Settings"
             xmlns:dash="using:Synapic.Main.Views.Dashboard"
             xmlns:help="using:Synapic.Main.Services"
             x:Class="Synapic.Main.Views.Settings.SettingsTab"
             x:DataType="vm:MainWindowViewModel">

  <!-- The Settings view as six tabs (ui-design §5, 2026-10-11 revision): the
       long single column is now one concern per tab, because a new user could
       not see where one concern ended and the next began —

         · Connection   — the data source and its limits (the run's scope is
                          chosen on the processing view, D10; the source itself
                          and its limits are app configuration).
         · Inference    — the sidecar: status, Start/Stop/Build/Download.
         · Tagging      — the model, device and tagging behaviour.
         · Dedup        — the scan and keep-set rules.
         · Upscale      — the workflow, factor and output.
         · App          — appearance, logging, defaults and about.

       Every section keeps its x:Name (SectionDataSource, SectionEngine, …) so
       the shell tests and the help scope keep working. Each tab's content is a
       scrolling column, so a tab of any height works at every audited size.

       Search (the AutoCompleteBox above the strip): a query switches to the
       tab the query names and reports it; picking a suggestion does the same.
       An empty query resets the status. -->
  <Grid RowDefinitions="Auto,Auto,*" Margin="0,0,0,12"
        help:HelpScope.Topic="settings-reference.html">

    <StackPanel Grid.Row="0" Spacing="2">
      <TextBlock Text="Settings" Classes="stepTitle" />
      <TextBlock Classes="hint" TextWrapping="Wrap"
                 Text="Everything the app needs configured, one concern per tab. The processing views run with what is set here." />
    </StackPanel>

    <!-- The search sits above the tabs: what it matches is what a tab pages in. -->
    <Border Grid.Row="1" Classes="card settingsCard" Padding="12" Margin="0,4"
            help:HelpScope.Topic="settings-reference.html">
      <StackPanel Spacing="6">
        <!-- A dropdown of the settings names as you type; picking one shows
             the tab it lives on. -->
        <TextBlock Classes="hint" Text="Search settings — show the tab a setting lives on (e.g. Daminion, model, dedup, theme)." />
        <AutoCompleteBox x:Name="SettingsSearchBox" FilterMode="Contains"
                         MaxDropDownHeight="260" />
        <TextBlock x:Name="SearchStatusText" Classes="hint" IsVisible="False" />
      </StackPanel>
    </Border>

    <TabControl Grid.Row="2" x:Name="SettingsTabs" Background="Transparent">
      <TabItem x:Name="TabConnection" Header="Connection">
        <ScrollViewer>
          <StackPanel Spacing="12" Margin="0,8,0,0">
            <Border Classes="card settingsCard" x:Name="SectionDataSource"
                    Padding="16" help:HelpScope.Topic="step1-datasource.html">
              <StackPanel Spacing="8">
                <TextBlock Text="Data source" Classes="sectionTitle" />
                <TextBlock Classes="hint" TextWrapping="Wrap"
                           Text="One source for every operation: a local folder, or a Daminion catalog with its scope and filters. Connect to the server here. The catalog scope and its filters are chosen on the processing view that runs." />
                <steps:DatasourceSourcePanel DataContext="{Binding Operations.Source}" />

                <Separator Margin="0,2" />

                <op:SourceLimitsPanel DataContext="{Binding Operations.Source}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="TabServer" Header="Inference">
        <ScrollViewer>
          <StackPanel Spacing="12" Margin="0,8,0,0">
            <Border Classes="card settingsCard" x:Name="SectionInferenceServer" Padding="16">
              <settings:InferenceServerSection />
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="TabEngine" Header="Tagging">
        <ScrollViewer>
          <StackPanel Spacing="12" Margin="0,8,0,0">
            <Border Classes="card settingsCard" x:Name="SectionEngine"
                    Padding="16" help:HelpScope.Topic="step2-engine.html">
              <StackPanel Spacing="8">
                <TextBlock Text="Inference engine" Classes="sectionTitle" />
                <TextBlock Classes="hint" TextWrapping="Wrap"
                           Text="The model, the compute device and the tagging behaviour every tagging run uses." />
                <steps:Step2Engine DataContext="{Binding Operations.TagParameters}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="TabDedup" Header="Dedup">
        <ScrollViewer>
          <StackPanel Spacing="12" Margin="0,8,0,0">
            <Border Classes="card settingsCard" x:Name="SectionDedup"
                    Padding="16" help:HelpScope.Topic="dedup.html">
              <StackPanel Spacing="8">
                <TextBlock Text="Deduplication" Classes="sectionTitle" />
                <TextBlock Classes="hint" TextWrapping="Wrap"
                           Text="How the deduplication view decides what counts as a duplicate: the algorithm, the threshold and the keep-set rule." />
                <steps:DedupSettingsPanel DataContext="{Binding Operations.Dedup}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="TabUpscale" Header="Upscale">
        <ScrollViewer>
          <StackPanel Spacing="12" Margin="0,8,0,0">
            <Border Classes="card settingsCard" x:Name="SectionUpscale"
                    Padding="16" help:HelpScope.Topic="upscale.html">
              <StackPanel Spacing="8">
                <TextBlock Text="Upscaling" Classes="sectionTitle" />
                <TextBlock Classes="hint" TextWrapping="Wrap"
                           Text="The workflow, scale factor, precision and output the upscaling view runs with." />
                <steps:UpscaleSettingsPanel DataContext="{Binding Operations.Upscale}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="TabApp" Header="App">
        <ScrollViewer>
          <StackPanel Spacing="12" Margin="0,8,0,0">
            <dash:SettingsPanel DataContext="{Binding AppSettings}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
