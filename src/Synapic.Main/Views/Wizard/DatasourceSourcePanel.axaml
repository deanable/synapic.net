<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Synapic.Main.ViewModels.Steps"
             xmlns:steps="using:Synapic.Main.Views.Wizard"
             xmlns:help="using:Synapic.Main.Services"
             x:Class="Synapic.Main.Views.Wizard.DatasourceSourcePanel"
             x:DataType="vm:Step1DatasourceViewModel">

  <!-- Where the images come from: the source choice, the folder, and the Daminion
       login — the source profile and the connection. It is the body of the
       Settings view's Data source section (ui-design §5/§8, D10).

       What the run works on — the catalog scope, its filters and the record
       count — is no longer here: it is chosen on the processing view that runs
       (ScopeSelectionPanel), because a scope belongs to a run rather than to the
       app's configuration. One shared source state, so the scope picked there is
       the scope this form reports; the panel and this form bind the same view
       model instance.

       The Daminion form is stacked rather than one wide row: four controls in a
       row only fit at 1280 and the connect button was the first thing to be
       pushed off the edge. -->
  <StackPanel Spacing="12">

    <steps:SourceStatusStrip />

    <WrapPanel>
      <RadioButton Content="Local Folder" GroupName="ds" IsChecked="{Binding IsLocalSelected}"
                   Margin="0,0,16,8" />
      <RadioButton Content="Daminion Server" GroupName="ds" IsChecked="{Binding IsDaminionSelected}"
                   Margin="0,0,16,8" />
    </WrapPanel>

    <!-- Local panel -->
    <Border IsVisible="{Binding IsLocal}" Classes="card" Padding="16"
            help:HelpScope.Topic="step1-datasource.html">
      <StackPanel Spacing="8">
        <TextBlock Classes="sectionTitle" Text="Folder containing images" />
        <Grid ColumnDefinitions="*,Auto" help:HelpScope.Topic="settings-reference.html#local-path">
          <TextBox Grid.Column="0" Watermark="C:\Pictures or /home/user/pictures"
                   Text="{Binding LocalPath}" />
          <Button Grid.Column="1" Content="Browse…" Click="OnBrowseFolder" Margin="8,0,0,0" />
        </Grid>
        <CheckBox Content="Include subfolders (recursive scan)" IsChecked="{Binding LocalRecursive}"
                  help:HelpScope.Topic="settings-reference.html#local-recursive" />
      </StackPanel>
    </Border>

    <!-- Daminion panel -->
    <Border IsVisible="{Binding IsDaminion}" Classes="card" Padding="16"
            help:HelpScope.Topic="step1-daminion.html">
      <StackPanel Spacing="8">
        <TextBlock Classes="sectionTitle" Text="Server" />

        <!-- Connected state: the credentials are for the login only, so once
             authenticated the form is replaced by the status line and Disconnect.
             Editing the URL/user mid-session would silently describe a server
             Synapic is not talking to: change servers by Disconnect + Connect. -->
        <StackPanel Spacing="8" IsVisible="{Binding IsDaminionConnected}">

          <TextBlock Text="{Binding DaminionUrl}" FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding DaminionUrl}" />

          <!-- The catalog is chosen by the server URL, so there is nothing to fill
               in by hand. Daminion exposes no endpoint that lists a server's
               catalogs, so after connecting we report the one the login landed on. -->
          <TextBlock Classes="hint" TextWrapping="Wrap"
                     Text="{Binding ActiveCatalogText}"
                     IsVisible="{Binding HasActiveCatalog}"
                     ToolTip.Tip="The catalog this login is bound to, selected by the server URL. Daminion has no API to list a server's catalogs, so this reports the one in use." />

          <WrapPanel>
            <Button Content="Disconnect" Command="{Binding DisconnectCommand}"
                    Margin="0,0,12,8" />
            <ProgressBar IsIndeterminate="True" Width="90" Height="6" VerticalAlignment="Center"
                         IsVisible="{Binding IsLoadingCatalog}" Margin="0,0,12,8" />
            <TextBlock Text="{Binding ConnectionMessage}" Opacity="0.85" TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       IsVisible="{Binding ConnectionMessage}" Margin="0,0,12,8" />
          </WrapPanel>
        </StackPanel>

        <!-- Not connected: the login form, shown as before. -->
        <StackPanel Spacing="8" IsVisible="{Binding !IsDaminionConnected}">

          <TextBox Watermark="Server URL, e.g. http://dam.local/daminion"
                   Text="{Binding DaminionUrl}"
                   help:HelpScope.Topic="settings-reference.html#server-url" />

          <TextBox Watermark="Username" Text="{Binding DaminionUser}" />
          <TextBox Watermark="Password" Text="{Binding DaminionPass}"
                   PasswordChar="*" />
          <WrapPanel>
            <Button Content="Connect" Command="{Binding ConnectCommand}" Classes="accent"
                    IsEnabled="{Binding !IsConnecting}" Margin="0,0,8,8" />
            <Button Content="Cancel" Command="{Binding CancelConnectCommand}"
                    IsVisible="{Binding IsConnecting}" Margin="0,0,8,8" />
            <ProgressBar IsIndeterminate="True" Width="90" Height="6"
                         IsVisible="{Binding IsConnecting}" VerticalAlignment="Center"
                         Margin="0,0,12,8" />
            <TextBlock Text="{Binding ConnectionMessage}" Opacity="0.85" TextWrapping="Wrap"
                       IsVisible="{Binding ConnectionMessage}" Margin="0,0,12,8" />
          </WrapPanel>
        </StackPanel>

        <!-- The scope now travels with the run: each processing view carries the
             scope and filter choice, so the selection is made where the work
             happens rather than three views away. The hint names no mode on
             purpose: the Settings search matches section copy, and naming them
             here would drag this section into a search for any of them. -->
        <TextBlock Classes="hint" TextWrapping="Wrap"
                   Text="The catalog scope, its filters and the record count are chosen on the processing view that runs — one scope, shown where the work happens." />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
