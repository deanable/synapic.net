<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Synapic.Main.ViewModels.Steps"
             xmlns:help="using:Synapic.Main.Services"
             x:Class="Synapic.Main.Views.Wizard.Step3Process"
             x:DataType="vm:Step3ProcessViewModel">

  <!-- 4 · Process: the batch itself. The settings it runs with are in ⚙ Settings
       and reported back on step 3, so this page is progress and control only. -->
  <StackPanel Spacing="12">
    <TextBlock Classes="stepTitle" Text="4 · Process" />

    <Border Classes="card settingsCard" Padding="16" help:HelpScope.Topic="step3-process.html">
      <StackPanel Spacing="10">
        <TextBlock Classes="sectionTitle" Text="Progress" />
        <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="18" />
        <WrapPanel>
          <TextBlock Text="{Binding ProgressText}" FontWeight="SemiBold" Margin="0,0,16,8" />
          <TextBlock Text="{Binding EtaText}" Opacity="0.7" Margin="0,0,16,8" />
          <TextBlock Text="{Binding CurrentFile}" Opacity="0.7" Margin="0,0,16,8"
                     TextWrapping="Wrap" MaxWidth="520" />
        </WrapPanel>
        <WrapPanel>
          <Button Content="Start Processing" Command="{Binding StartCommand}"
                  Classes="accent" IsEnabled="{Binding IsIdle}" Margin="0,0,8,8" />
          <Button Content="Pause" Command="{Binding PauseCommand}" Margin="0,0,8,8" />
          <Button Content="Resume" Command="{Binding ResumeCommand}" Margin="0,0,8,8" />
          <Button Content="Abort" Command="{Binding AbortCommand}" Margin="0,0,8,8" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <Border Classes="card" Height="320" Padding="8"
            help:HelpScope.Topic="step3-log.html">
      <ListBox ItemsSource="{Binding LogLines}" x:Name="LogList">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" FontFamily="Consolas,monospace" FontSize="12" TextWrapping="Wrap" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </StackPanel>
</UserControl>
