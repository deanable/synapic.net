<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Synapic.Main.ViewModels.Steps"
             xmlns:help="using:Synapic.Main.Services"
             x:Class="Synapic.Main.Views.Wizard.StepDedup"
             x:DataType="vm:StepDedupViewModel">

  <!-- The image-matching run page — one view for both the Deduplication and the
       Similar images operations, whose view models are the same class under two
       profiles. What the scan works on, the scan itself, the review of the groups
       and the apply: the rule settings (algorithm, threshold, server hashing,
       keep-set rules) live in the operation's Settings tab (Dedup or Similar), and
       the page reports them back on the rule line so a scan is never started
       blind. The headings and the hints that name the search come from the view
       model (ScanCardTitle, RunPageHint, ApplyCardTitle, ApplyHint), so the
       similar view never reads as the duplicate view. -->
  <StackPanel Spacing="12">
    <TextBlock Classes="hint" Text="{Binding RunPageHint}" />

    <!-- The source the scan runs on comes from the shared data-source strip
         (Region A): one source, configured once, shown identically in every
         mode — this page no longer offers a second, dedup-only source. -->

    <!-- The scan, with its rules read back from the Settings view. The scan
         itself is started and stopped on the shared run bar above (D10, whose
         primary action is this mode's "Scan" and whose Stop is its scan Stop) —
         this card reports the rules and the result, so the scan has one entry
         point and one Stop instead of two of each. -->
    <Border Classes="card settingsCard" Padding="16">
      <StackPanel Spacing="8">
        <TextBlock Classes="sectionTitle" Text="{Binding ScanCardTitle}"
                   TextTrimming="CharacterEllipsis" />

        <TextBlock Classes="hint" Text="{Binding ScanSettingsSummary}" />

        <!-- Live sensitivity: the last scan's fingerprints are retained, so this
             re-groups the current results instead of asking for a rescan. It
             appears only once there is something to re-filter, and the 300 ms
             debounce on the value is what makes a drag one recalculation rather
             than one per pixel. -->
        <StackPanel Spacing="2" IsVisible="{Binding CanRetune}">
          <WrapPanel>
            <TextBlock Text="Threshold:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Slider x:Name="RetuneThresholdSlider" Width="280" Minimum="0.5" Maximum="1"
                    TickFrequency="0.005" VerticalAlignment="Center"
                    Value="{Binding Threshold, Mode=TwoWay}" />
            <TextBlock Text="{Binding Threshold, StringFormat='{}{0:0.###}'}"
                       VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold" />
          </WrapPanel>
          <TextBlock Classes="hint" Text="{Binding RetuneHint}" TextWrapping="Wrap" />
        </StackPanel>
        <!-- Retained fingerprints only re-group; this walks and hashes every
             file again — the escape when source files changed or the last scan
             was trimmed. Hidden while nothing is retained (a scan then hashes
             anyway). -->
        <Button x:Name="HashAgainButton" Content="Re-hash from disk"
                Command="{Binding HashAgainCommand}"
                IsVisible="{Binding HasRetainedScan}"
                Margin="0,0,8,4"
                ToolTip.Tip="Ignore the retained fingerprints and re-hash every file in the source — for folders or scopes that changed since the last scan." />
        <ProgressBar IsIndeterminate="True" Height="4" IsVisible="{Binding IsRetuning}" />

        <ProgressBar IsIndeterminate="True" Height="6" IsVisible="{Binding IsScanning}" />
        <TextBlock Text="{Binding ScanSummary}" Opacity="0.8" TextWrapping="Wrap"
                   IsVisible="{Binding ScanSummary}" />

        <!-- Retrieval diagnostics for the last catalog walk: the count the
             source panel shows, the total the pages themselves reported, the
             pages read, the raw records scanned and the unique items kept —
             side by side, so a mismatch is visible without opening
             logs/synapic.log. The numbers themselves are read-only. The only
             controls act on them: a re-walk that follows page totals when the
             count and the kept items disagree, and an export of the report.
             Both leave the catalog untouched. Appears only for a Daminion
             source after a walk. -->
        <Border x:Name="RetrievalDiagnostics"
                IsVisible="{Binding HasRetrievalDiagnostics}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1" CornerRadius="6" Padding="10,8"
                ToolTip.Tip="What the last Daminion walk actually did: the scope count, the pages' own total, and how many items it kept. The numbers are read-only; the actions re-walk or export.">
          <StackPanel Spacing="6">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Classes="hint"
                         Text="{Binding RetrievalScopeText}" />
              <TextBlock Text="Catalog retrieval — last walk" FontSize="12"
                         FontWeight="SemiBold" />
            </DockPanel>
            <WrapPanel>
              <StackPanel MinWidth="92" Margin="0,0,20,4"
                          ToolTip.Tip="The scope count shown for the connection — the same query the walk is steered by on all/keyword scopes.">
                <TextBlock Classes="hint" Text="Counted" />
                <TextBlock x:Name="RetrievalCountValue" FontSize="16" FontWeight="SemiBold"
                           Text="{Binding RetrievalCountText}" />
              </StackPanel>
              <StackPanel MinWidth="92" Margin="0,0,20,4"
                          ToolTip.Tip="The totalCount the catalog pages themselves reported (the last one seen).">
                <TextBlock Classes="hint" Text="Page total" />
                <TextBlock x:Name="RetrievalPageTotalValue" FontSize="16" FontWeight="SemiBold"
                           Text="{Binding RetrievalPageTotalText}" />
              </StackPanel>
              <StackPanel MinWidth="92" Margin="0,0,20,4"
                          ToolTip.Tip="Pages read (one page is at most 500 catalog records).">
                <TextBlock Classes="hint" Text="Pages" />
                <TextBlock x:Name="RetrievalPagesValue" FontSize="16" FontWeight="SemiBold"
                           Text="{Binding RetrievalPagesText}" />
              </StackPanel>
              <StackPanel MinWidth="92" Margin="0,0,20,4"
                          ToolTip.Tip="Raw records the cursor consumed, including records a client-side filter dropped.">
                <TextBlock Classes="hint" Text="Raw scanned" />
                <TextBlock x:Name="RetrievalScannedValue" FontSize="16" FontWeight="SemiBold"
                           Text="{Binding RetrievalScannedText}" />
              </StackPanel>
              <StackPanel MinWidth="92" Margin="0,0,20,4"
                          ToolTip.Tip="Unique eligible items the walk handed to the scan — what was actually kept.">
                <TextBlock Classes="hint" Text="Kept" />
                <TextBlock x:Name="RetrievalKeptValue" FontSize="16" FontWeight="SemiBold"
                           Text="{Binding RetrievalKeptText}" />
              </StackPanel>
            </WrapPanel>
            <TextBlock Classes="hint" Text="{Binding RetrievalComparisonText}" />
            <WrapPanel>
              <!-- Only when the count and the kept items disagree: this is a
                   diagnostic second pass, not a normal scan path. -->
              <Button x:Name="ReWalkUsingPageTotalsButton"
                      Content="Re-walk using page totals"
                      Command="{Binding ReWalkUsingPageTotalsCommand}"
                      IsVisible="{Binding HasRetrievalMismatch}"
                      Margin="0,0,8,4"
                      ToolTip.Tip="Runs the catalog walk again and lets each page's total steer the progress bar instead of the scope count. The catalog is not changed." />
              <Button x:Name="ExportRetrievalReportButton"
                      Content="Export report"
                      Command="{Binding ExportRetrievalReportCommand}"
                      Margin="0,0,8,4"
                      ToolTip.Tip="Writes this walk's numbers and comparison to a text file in Documents." />
            </WrapPanel>
            <TextBlock Classes="hint" Text="{Binding RetrievalActionMessage}"
                       IsVisible="{Binding HasRetrievalActionMessage}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <TextBlock Text="{Binding SelectionSummary}" FontWeight="SemiBold" TextWrapping="Wrap"
               IsVisible="{Binding SelectionSummary}" />

    <!-- Vertical list of match group cards, each item row with a checkbox. -->
    <ListBox ItemsSource="{Binding Groups}" MaxHeight="380">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:DuplicateGroupViewModel">
          <Border Classes="card" Padding="12" Margin="0,0,0,8">
            <StackPanel Spacing="4">
              <DockPanel>
                <TextBlock Text="{Binding Summary}" FontSize="12" Opacity="0.75"
                           DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" VerticalAlignment="Center" />
              </DockPanel>
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DedupItemViewModel">
                    <!-- Auto thumb column: rows without a preview collapse it
                         instead of showing an empty box. Double-tapping the row
                         is the quick keep/exclude toggle; right-clicking opens a
                         menu with the same actions per item (fast exclusion from
                         the apply batch). -->
                    <Grid ColumnDefinitions="Auto,Auto,*,150,90" Margin="4,2"
                          DoubleTapped="OnGroupItemDoubleTapped"
                          ContextRequested="OnGroupItemContextRequested"
                          ToolTip.Tip="Double-click to keep/exclude this image from the action; right-click for the menu.">
                      <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" VerticalAlignment="Center" />
                      <Image Grid.Column="1" Source="{Binding Thumb}" IsVisible="{Binding HasThumb}"
                             Width="44" Height="44" Margin="8,0,0,0" Stretch="Uniform"
                             VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding DisplayName}" Margin="8,0"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                 ToolTip.Tip="{Binding DisplayName}" />
                      <TextBlock Grid.Column="3" Text="{Binding DateText}" Opacity="0.75" FontSize="12"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4" Text="{Binding SizeText}" Opacity="0.75" FontSize="12"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Action + apply (un-checked items across all groups). -->
    <Border Classes="card settingsCard" Padding="16">
      <StackPanel Spacing="8">
        <TextBlock Classes="sectionTitle" Text="{Binding ApplyCardTitle}" />
        <WrapPanel>
          <TextBlock Classes="fieldLabel" Text="Action:" Margin="0,0,8,8"
                     help:HelpScope.Topic="settings-reference.html#dedup-action" />
          <ComboBox SelectedIndex="{Binding SelectedAction}" ItemsSource="{Binding Actions}"
                    MinWidth="180" Margin="0,0,16,8" />
          <!-- Destination folder for "Move to folder…": chosen once, remembered
               in the registry, and the same for every run (local source only). -->
          <TextBox Width="260" Margin="0,0,8,8"
                   Text="{Binding MoveDestinationFolder}"
                   IsVisible="{Binding IsMoveActionSelected}"
                   Watermark="Destination folder for moved duplicates"
                   help:HelpScope.Topic="settings-reference.html#dedup-action" />
          <Button Content="Browse…" Margin="0,0,16,8"
                  IsVisible="{Binding IsMoveActionSelected}"
                  Click="OnBrowseMoveFolder" />
          <Button Content="Apply" Command="{Binding ApplyCommand}" Classes="accent"
                  IsEnabled="{Binding !IsApplying}" Margin="0,0,16,8" />
          <!-- UI-REVIEW #1, apply half: the operation is indeterminate for its
               whole duration, Apply is off while it runs, and Stop stays live —
               a multi-minute catalog delete is never a silently greyed button. -->
          <Button Content="Stop" Command="{Binding StopApplyCommand}"
                  IsVisible="{Binding IsApplying}" IsEnabled="{Binding IsApplying}"
                  Margin="0,0,16,8"
                  ToolTip.Tip="Cancel the apply in progress; what it already changed stays changed." />
        </WrapPanel>
        <ProgressBar IsIndeterminate="True" Height="6" IsVisible="{Binding IsApplying}" />
        <TextBlock Classes="hint" IsVisible="{Binding IsApplying}" Text="{Binding ApplyingHint}" />
        <TextBlock Classes="hint" Text="{Binding ApplyHint}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
