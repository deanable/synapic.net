<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Synapic.Main.ViewModels.Steps"
             xmlns:help="using:Synapic.Main.Services"
             x:Class="Synapic.Main.Views.Wizard.StepDedup"
             x:DataType="vm:StepDedupViewModel">

  <!-- 4 · Deduplication: what the scan works on, the scan itself, the review of
       the groups and the apply. The rule settings (algorithm, threshold, server
       hashing, keep-set rules) live in 3 · Settings, and the page reports them
       back on the rule line so the scan is never started blind. -->
  <StackPanel Spacing="12">
    <TextBlock Classes="stepTitle" Text="4 · Deduplication" />
    <TextBlock Classes="hint"
               Text="Scan rules and the keep-set rule live in ⚙ Settings; the scan, the review and the apply happen here." />

    <!-- Source: local folder vs the Step 1 Daminion scope (the same choice as
         step 1 makes, offered here so a scan can cover a different folder). -->
    <Border Classes="card settingsCard" Padding="16" help:HelpScope.Topic="dedup.html">
      <StackPanel Spacing="8">
        <TextBlock Classes="sectionTitle" Text="Source to scan" />

        <WrapPanel>
          <RadioButton Content="Local Folder" GroupName="dedupds"
                       IsChecked="{Binding IsLocalSelected}" Margin="0,0,16,8" />
          <RadioButton Content="Daminion Catalog" GroupName="dedupds"
                       IsChecked="{Binding IsDaminionSelected}" Margin="0,0,16,8" />
        </WrapPanel>

        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsLocal}"
              help:HelpScope.Topic="settings-reference.html#dedup-folder">
          <TextBox Watermark="Folder to scan" Text="{Binding FolderPath}" />
          <Button Grid.Column="1" Content="Browse…" Click="OnBrowseFolder" Margin="8,0,0,0" />
        </Grid>

        <StackPanel Spacing="4" IsVisible="{Binding IsDaminion}">
          <TextBlock Text="{Binding DaminionScopeSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Classes="hint"
                     Text="The catalog scope is chosen in 1 · Source &amp; model — items the catalog already hashed are compared without downloading; the rest are downloaded one at a time and hashed." />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- The scan, with its rules read back from the settings dialog. -->
    <Border Classes="card settingsCard" Padding="16">
      <StackPanel Spacing="8">
        <DockPanel>
          <!-- The buttons keep their size at the right edge; the heading line
               ellipsizes instead of pushing them out of the card. -->
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                      Margin="12,0,0,0">
            <Button Content="⚙ Settings" Command="{Binding OpenSettingsCommand}"
                    ToolTip.Tip="Algorithm, threshold, server hashing and the keep-set rules" />
            <Button Content="Scan" Command="{Binding ScanCommand}" Classes="accent"
                    ToolTip.Tip="Scan the source for duplicate groups." />
          </StackPanel>
          <TextBlock Classes="sectionTitle" Text="Scan for duplicates"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <TextBlock Classes="hint" Text="{Binding ScanSettingsSummary}" />

        <ProgressBar IsIndeterminate="True" Height="6" IsVisible="{Binding IsScanning}" />
        <TextBlock Text="{Binding ScanSummary}" Opacity="0.8" TextWrapping="Wrap"
                   IsVisible="{Binding ScanSummary}" />
      </StackPanel>
    </Border>

    <TextBlock Text="{Binding SelectionSummary}" FontWeight="SemiBold" TextWrapping="Wrap"
               IsVisible="{Binding SelectionSummary}" />

    <!-- Vertical list of duplicate group cards, each item row with a checkbox. -->
    <ListBox ItemsSource="{Binding Groups}" MaxHeight="380">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:DuplicateGroupViewModel">
          <Border Classes="card" Padding="12" Margin="0,0,0,8">
            <StackPanel Spacing="4">
              <DockPanel>
                <TextBlock Text="{Binding Summary}" FontSize="12" Opacity="0.75"
                           DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" VerticalAlignment="Center" />
              </DockPanel>
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DedupItemViewModel">
                    <!-- Auto thumb column: rows without a preview collapse it
                         instead of showing an empty box. -->
                    <Grid ColumnDefinitions="Auto,Auto,*,150,90" Margin="4,2">
                      <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" VerticalAlignment="Center" />
                      <Image Grid.Column="1" Source="{Binding Thumb}" IsVisible="{Binding HasThumb}"
                             Width="44" Height="44" Margin="8,0,0,0" Stretch="Uniform"
                             VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding DisplayName}" Margin="8,0"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                 ToolTip.Tip="{Binding DisplayName}" />
                      <TextBlock Grid.Column="3" Text="{Binding DateText}" Opacity="0.75" FontSize="12"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4" Text="{Binding SizeText}" Opacity="0.75" FontSize="12"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Action + apply (un-checked items across all groups). -->
    <Border Classes="card settingsCard" Padding="16">
      <StackPanel Spacing="8">
        <TextBlock Classes="sectionTitle" Text="Apply to the unchecked duplicates" />
        <WrapPanel>
          <TextBlock Classes="fieldLabel" Text="Action:" Margin="0,0,8,8"
                     help:HelpScope.Topic="settings-reference.html#dedup-action" />
          <ComboBox SelectedIndex="{Binding SelectedAction}" ItemsSource="{Binding Actions}"
                    MinWidth="180" Margin="0,0,16,8" />
          <Button Content="Apply" Command="{Binding ApplyCommand}" Classes="accent"
                  Margin="0,0,16,8" />
        </WrapPanel>
        <TextBlock Classes="hint"
                   Text="Checked items are kept; the action runs on every unchecked duplicate across all groups — each destructive action asks first." />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
