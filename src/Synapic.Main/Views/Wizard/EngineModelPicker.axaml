<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Synapic.Main.ViewModels.Steps"
             xmlns:help="using:Synapic.Main.Services"
             x:Class="Synapic.Main.Views.Wizard.EngineModelPicker"
             x:DataType="vm:Step2EngineViewModel">

  <!-- The model half of "1 · Source & model": which model tags the images and
       which device it runs on. It is the compact form of what the Parameters
       region shows in full (that form lists every local model with its task and
       size; tag fields, thresholds and prompts live there too), so the setup
       screen answers "who does the work" without a wall of options.

       Every row wraps: the window has no minimum width and the model id can be
       long, so the last control moves to the next line instead of being clipped. -->
  <StackPanel Spacing="8">

    <WrapPanel help:HelpScope.Topic="settings-reference.html#model-id">
      <TextBlock Classes="fieldLabel" Text="Model:" Margin="0,0,8,8" />
      <ComboBox ItemsSource="{Binding LocalModels}"
                SelectedItem="{Binding SelectedModel}"
                DisplayMemberBinding="{Binding Id}"
                MinWidth="240" MaxWidth="460" Margin="0,0,12,8"
                PlaceholderText="Refresh to list local models"
                ToolTip.Tip="Models the running server already has on disk." />
      <Button Content="Refresh" Command="{Binding RefreshModelsCommand}"
              Margin="0,0,12,8"
              ToolTip.Tip="Ask the server which models are downloaded." />
      <Button Content="Download…" Command="{Binding DownloadSelectedCommand}"
              Margin="0,0,12,8"
              ToolTip.Tip="Download the model id below (or the selected one) from Hugging Face." />
      <ProgressBar IsIndeterminate="True" Width="90" Height="6"
                   IsVisible="{Binding IsLoadingModels}"
                   VerticalAlignment="Center" Margin="0,0,12,8" />
    </WrapPanel>

    <WrapPanel help:HelpScope.Topic="settings-reference.html#device">
      <TextBlock Classes="fieldLabel" Text="Device:" Margin="0,0,8,8" />
      <ComboBox SelectedItem="{Binding SelectedDevice}"
                ItemsSource="{Binding DeviceOptions}"
                MinWidth="120" Margin="0,0,12,8"
                ToolTip.Tip="CPU runs anywhere; CUDA is offered only when an NVIDIA driver was detected." />
      <TextBlock Classes="hint" VerticalAlignment="Center" MaxWidth="520" Margin="0,0,12,8"
                 Text="{Binding DeviceAvailabilityNote}"
                 IsVisible="{Binding HasDeviceAvailabilityNote}" />
    </WrapPanel>

    <TextBox Watermark="Model id (Hugging Face repo)" Text="{Binding ManualModelId}"
             help:HelpScope.Topic="settings-reference.html#model-id" />

    <TextBlock Classes="hint" Text="{Binding ModelsMessage}"
               IsVisible="{Binding ModelsMessage}" />
  </StackPanel>
</UserControl>
