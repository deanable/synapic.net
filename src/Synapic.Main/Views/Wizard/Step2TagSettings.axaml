<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Synapic.Main.ViewModels.Steps"
             xmlns:help="using:Synapic.Main.Services"
             x:Class="Synapic.Main.Views.Wizard.Step2TagSettings"
             x:DataType="vm:Step2EngineViewModel">

  <!-- 3 · Settings, as a page: the summary of what the tagging run will use,
       with the full form directly above in the Parameters region — one view
       model, so the summary follows every edit. The page exists because the
       run's two guard rails live here — at least one tag field has to be
       ticked, and a partial selection has to be visible before the batch
       starts, not after Daminion shows half-empty records. -->
  <StackPanel Spacing="12">
    <TextBlock Classes="stepTitle" Text="3 · Settings" />
    <TextBlock Classes="hint"
               Text="What the tagging run will write. Change any of it in the Parameters region above — it edits this same state, so the summary here updates with it." />

    <Border Classes="card settingsCard" Padding="16" help:HelpScope.Topic="step2-settings.html">
      <StackPanel Spacing="10">
        <TextBlock Classes="sectionTitle" Text="Tagging settings" />

        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
              help:HelpScope.Topic="step2-settings.html">
          <TextBlock Grid.Row="0" Grid.Column="0" Classes="fieldLabel" Text="Model:" />
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ModelSummary}"
                     TextTrimming="CharacterEllipsis" Margin="0,0,0,4"
                     ToolTip.Tip="{Binding ModelSummary}" />

          <TextBlock Grid.Row="1" Grid.Column="0" Classes="fieldLabel" Text="Device:" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Device}" Margin="0,0,0,4" />

          <TextBlock Grid.Row="2" Grid.Column="0" Classes="fieldLabel" Text="Tag fields:" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TagFieldSummary}"
                     TextWrapping="Wrap" Margin="0,0,0,4" />

          <TextBlock Grid.Row="3" Grid.Column="0" Classes="fieldLabel" Text="Confidence threshold:" />
          <TextBlock Grid.Row="3" Grid.Column="1"
                     Text="{Binding ConfidenceThreshold, StringFormat={}{0:0.00}}"
                     Margin="0,0,0,4" />

          <TextBlock Grid.Row="4" Grid.Column="0" Classes="fieldLabel" Text="Probability mode:" />
          <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ProbabilitySummary}"
                     TextWrapping="Wrap" Margin="0,0,0,4" />

          <TextBlock Grid.Row="5" Grid.Column="0" Classes="fieldLabel" Text="Prompt:" />
          <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding PromptSummary}"
                     TextWrapping="Wrap" Margin="0,0,0,4" />

          <TextBlock Grid.Row="6" Grid.Column="0" Classes="fieldLabel" Text="Model id:" />
          <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ManualModelId}"
                     TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding ManualModelId}" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- The two gates. The Start button on the next step is disabled on the
         first one and the action bar repeats the message. -->
    <Border Classes="card settingsCard" Padding="16"
            IsVisible="{Binding HasNoTagFieldSelected}"
            help:HelpScope.Topic="step2-tag-fields.html">
      <StackPanel Spacing="6">
        <TextBlock Classes="sectionTitle" Text="No tag field selected" />
        <TextBlock Foreground="{DynamicResource SynapicDangerBrush}" TextWrapping="Wrap"
                   Text="Tick at least one of Keywords, Categories or Description in ⚙ Settings: a run with no field selected has nothing to write." />
      </StackPanel>
    </Border>

    <Border Classes="card settingsCard" Padding="16"
            IsVisible="{Binding HasPartialTagFieldSelection}"
            help:HelpScope.Topic="step2-tag-fields.html">
      <StackPanel Spacing="6">
        <TextBlock Classes="sectionTitle" Text="Partial tag field selection" />
        <TextBlock Foreground="{DynamicResource SynapicWarningBrush}" TextWrapping="Wrap"
                   Text="{Binding TagFieldWarning}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
