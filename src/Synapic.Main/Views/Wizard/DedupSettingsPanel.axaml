<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Synapic.Main.ViewModels.Steps"
             xmlns:help="using:Synapic.Main.Services"
             x:Class="Synapic.Main.Views.Wizard.DedupSettingsPanel"
             x:DataType="vm:StepDedupViewModel">

  <!-- The deduplication settings: how the scan compares images, and which rule
       drives the keep-set. They used to sit inline above the results, which
       pushed the group list down and clipped the rule hint off the card at
       anything under 1280. The review page keeps the review, the scan and the
       apply; the rules live here. -->
  <StackPanel Spacing="12">

    <Border Classes="card settingsCard" Padding="16"
            help:HelpScope.Topic="settings-reference.html#dedup-algorithm">
      <StackPanel Spacing="8">
        <TextBlock Classes="sectionTitle" Text="Scan" />

        <WrapPanel>
          <TextBlock Classes="fieldLabel" Text="Algorithm:" Margin="0,0,8,8" />
          <ComboBox SelectedIndex="{Binding SelectedAlgorithm}" ItemsSource="{Binding Algorithms}"
                    MinWidth="140" Margin="0,0,16,8" />
          <TextBlock Classes="fieldLabel" Text="Threshold:" Margin="0,0,8,8" />
          <Slider Minimum="0.5" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True"
                  Width="160" Value="{Binding Threshold, Mode=TwoWay}" Margin="0,0,8,8"
                  help:HelpScope.Topic="settings-reference.html#dedup-threshold"
                  ToolTip.Tip="{Binding ThresholdHint}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Threshold, StringFormat={}{0:0.00}}"
                     FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="40" Margin="0,0,16,8"
                     help:HelpScope.Topic="settings-reference.html#dedup-threshold" />
        </WrapPanel>

        <WrapPanel>
          <TextBlock Classes="fieldLabel" Text="Server hash:" Margin="0,0,8,8"
                     IsVisible="{Binding IsDaminion}"
                     help:HelpScope.Topic="settings-reference.html#dedup-server-hash" />
          <ComboBox SelectedIndex="{Binding SelectedServerHashMatch, Mode=TwoWay}"
                    ItemsSource="{Binding ServerHashMatches}" MinWidth="140"
                    Margin="0,0,16,8"
                    IsVisible="{Binding IsDaminion}"
                    help:HelpScope.Topic="settings-reference.html#dedup-server-hash" />
        </WrapPanel>

        <TextBlock Classes="hint" Text="{Binding ServerHashMatchHint}" IsVisible="{Binding IsDaminion}" />
      </StackPanel>
    </Border>

    <Border Classes="card settingsCard" Padding="16"
            help:HelpScope.Topic="settings-reference.html#dedup-autoselect">
      <StackPanel Spacing="8">
        <TextBlock Classes="sectionTitle" Text="Keep-set rules" />
        <TextBlock Classes="hint" Text="{Binding KeepSetHint}" />

        <!-- Auto-select rules: tick these to drive every group's keep checkboxes. -->
        <WrapPanel>
          <CheckBox Content="Oldest" IsChecked="{Binding SelectOldest}" Margin="0,0,16,8" />
          <CheckBox Content="Newest" IsChecked="{Binding SelectNewest}" Margin="0,0,16,8" />
          <CheckBox Content="Smallest" IsChecked="{Binding SelectSmallest}" Margin="0,0,16,8" />
          <CheckBox Content="Largest" IsChecked="{Binding SelectLargest}" Margin="0,0,16,8" />
        </WrapPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
