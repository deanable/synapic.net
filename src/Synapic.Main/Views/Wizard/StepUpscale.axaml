<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Synapic.Main.ViewModels.Steps"
             xmlns:help="using:Synapic.Main.Services"
             x:Class="Synapic.Main.Views.Wizard.StepUpscale"
             x:DataType="vm:StepUpscaleViewModel">

  <!-- The upscaling page. The parameters live in the Settings view's Upscaling
       section and are reported back here before a batch starts, so the run is
       never blind; the run itself — progress, Start, Stop and the log — is the
       shared run bar above this page (D10). A second progress bar and a second
       log here is exactly what the tagging view shipped and what was removed. -->
  <StackPanel Spacing="12">
    <TextBlock Text="{Binding SourceSummary}" Opacity="0.75" TextWrapping="Wrap"
               help:HelpScope.Topic="upscale.html" />

    <Border Classes="card settingsCard" Padding="16">
      <StackPanel Spacing="8">
        <TextBlock Classes="sectionTitle" Text="Upscaling parameters"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Classes="hint" Text="{Binding SettingsSummary}" />
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
