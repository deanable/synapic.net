<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Synapic.Main.ViewModels.Steps"
             xmlns:help="using:Synapic.Main.Services"
             x:Class="Synapic.Main.Views.Wizard.StepUpscale"
             x:DataType="vm:StepUpscaleViewModel">

  <!-- 4 · Upscaling: the run page. The parameters live in 3 · Settings and are
       reported back here before a batch starts, so the run is never blind. -->
  <StackPanel Spacing="12">
    <TextBlock Classes="stepTitle" Text="4 · Upscaling" />
    <TextBlock Text="{Binding SourceSummary}" Opacity="0.75" TextWrapping="Wrap"
               help:HelpScope.Topic="upscale.html" />

    <Border Classes="card settingsCard" Padding="16">
      <StackPanel Spacing="8">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="⚙ Settings" Margin="12,0,0,0"
                  Command="{Binding OpenSettingsCommand}"
                  ToolTip.Tip="Workflow, factor, precision, output format and the post-processing sliders" />
          <TextBlock Classes="sectionTitle" Text="Upscaling parameters"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <TextBlock Classes="hint" Text="{Binding SettingsSummary}" />
      </StackPanel>
    </Border>

    <Border Classes="card settingsCard" Padding="16" help:HelpScope.Topic="step3-process.html">
      <StackPanel Spacing="8">
        <TextBlock Classes="sectionTitle" Text="Run" />
        <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="18" />
        <WrapPanel>
          <TextBlock Text="{Binding ProgressText}" FontWeight="SemiBold" Margin="0,0,16,8" />
          <TextBlock Text="{Binding EtaText}" Opacity="0.7" Margin="0,0,16,8" />
          <TextBlock Text="{Binding CurrentFile}" Opacity="0.7" Margin="0,0,16,8"
                     TextWrapping="Wrap" MaxWidth="520" TextTrimming="CharacterEllipsis" />
        </WrapPanel>
        <WrapPanel>
          <Button Content="Run Upscale Batch" Command="{Binding StartCommand}"
                  Classes="accent" Margin="0,0,8,8" />
          <Button Content="Stop" Command="{Binding StopCommand}" Margin="0,0,8,8" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <Border Classes="card" Height="300" Padding="8"
            help:HelpScope.Topic="step3-log.html">
      <ListBox ItemsSource="{Binding LogLines}" x:Name="LogList">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" FontFamily="Consolas,monospace" FontSize="12"
                       TextWrapping="Wrap" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </StackPanel>
</UserControl>
