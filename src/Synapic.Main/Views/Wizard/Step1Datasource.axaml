<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Synapic.Main.ViewModels.Steps"
             xmlns:steps="using:Synapic.Main.Views.Wizard"
             xmlns:help="using:Synapic.Main.Services"
             x:Class="Synapic.Main.Views.Wizard.Step1Datasource"
             x:DataType="vm:Step1DatasourceViewModel">

  <StackPanel Spacing="12">
    <TextBlock Text="Step 1 — Datasource" FontSize="22" FontWeight="Bold" />

    <!-- The source and the scope are chosen on the start screen — that is where
         the three workflows are picked, so it is where "which images?" belongs.
         This card reports the choice; it does not ask for it twice. -->
    <Border Classes="card" Padding="14" help:HelpScope.Topic="step1-datasource.html">
      <StackPanel Spacing="8">
        <TextBlock Text="Working with" FontWeight="SemiBold" />
        <steps:SourceStatusStrip />
        <TextBlock Text="{Binding CountText}" Opacity="0.8" FontSize="12"
                   IsVisible="{Binding CountText}" />
        <TextBlock Text="Change the source, the scope or the filters on the start screen (⌂ Home)."
                   Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- Processing limits: how many items, and how much of each image -->
    <Border Classes="card" Padding="14" help:HelpScope.Topic="step1-limits.html">
      <StackPanel Spacing="8">
        <TextBlock Text="How many items, and how much of each image" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Spacing="16">
          <TextBlock Text="Max items:" VerticalAlignment="Center" />
          <NumericUpDown Value="{Binding MaxItems}" Minimum="0" Maximum="1000000"
                         Increment="50" Width="120" IsEnabled="{Binding !ProcessAll}"
                         help:HelpScope.Topic="settings-reference.html#max-items" />
          <CheckBox Content="Process all (page until empty)"
                    IsChecked="{Binding ProcessAll}" VerticalAlignment="Center"
                    help:HelpScope.Topic="settings-reference.html#process-all"
                    ToolTip.Tip="Ignore the max-items limit and keep requesting pages until the server returns no more results (use for catalogs larger than one API response)." />
          <TextBlock Text="AI image scale:" VerticalAlignment="Center" />
          <!-- The fixed 200px thumbnail replaces the image outright, so the
               scale has no effect while it is on. The chosen value is kept,
               not reset: unchecking the box brings it back exactly as it was,
               and ProcessingOrchestrator ignores ResizeScale when the
               override is on anyway. -->
          <ComboBox SelectedIndex="{Binding ResizeScaleIndex}"
                    ItemsSource="{Binding ResizeScaleOptions}" MinWidth="90"
                    IsEnabled="{Binding !UseThumbnailOverride}"
                    ToolTip.Tip="Off while the fixed 200px thumbnail is on - the thumbnail replaces the scaled image. Untick it to choose a scale again."
                    help:HelpScope.Topic="settings-reference.html#resize-scale" />
          <CheckBox Content="Use fixed 200px thumbnail (fast)"
                    IsChecked="{Binding UseThumbnailOverride}" VerticalAlignment="Center"
                    help:HelpScope.Topic="settings-reference.html#thumbnail-override" />
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
