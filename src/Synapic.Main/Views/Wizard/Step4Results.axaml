<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Synapic.Main.ViewModels.Steps"
             xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
             xmlns:help="using:Synapic.Main.Services"
             x:Class="Synapic.Main.Views.Wizard.Step4Results"
             x:DataType="vm:Step4ResultsViewModel">

  <!-- The report: what the batch wrote, and the ways out of it (export, retry,
       verify). The action row wraps — four buttons plus the summary line is more
       than a 1024px window fits on one line. -->
  <StackPanel Spacing="12">
    <TextBlock Classes="sectionTitle" Text="Report" />

    <Border Classes="card settingsCard" Padding="16" help:HelpScope.Topic="step4-results.html">
      <StackPanel Spacing="8">
        <WrapPanel>
          <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" Margin="0,0,8,8" />
          <Button Content="Retry Failed" Command="{Binding RetryFailedCommand}" Margin="0,0,8,8" />
          <Button Content="Verify Daminion Writes" Command="{Binding VerifyDaminionCommand}" Margin="0,0,8,8" />
          <Button Content="Refresh" Click="OnRefresh" Margin="0,0,8,8" />
        </WrapPanel>
        <TextBlock Text="{Binding Summary}" Opacity="0.8" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <dg:DataGrid ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" x:Name="ResultsGrid"
                 help:HelpScope.Topic="step4-results.html"
                 AutoGenerateColumns="False" CanUserSortColumns="True" Height="420"
                 GridLinesVisibility="Horizontal" IsReadOnly="True">
      <dg:DataGrid.Columns>
        <dg:DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="260" />
        <!-- Wide enough for "Success (repaired)", the status an item gets when
             the sidecar had to put the model's reply back together to read it. -->
        <dg:DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="170" />
        <dg:DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="150" />
        <dg:DataGridTextColumn Header="Keywords" Binding="{Binding KeywordsCsv}" Width="280" />
        <dg:DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
      </dg:DataGrid.Columns>
    </dg:DataGrid>
  </StackPanel>
</UserControl>
