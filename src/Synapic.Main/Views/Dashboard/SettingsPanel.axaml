<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Synapic.Main.ViewModels"
             xmlns:help="using:Synapic.Main.Services"
             x:Class="Synapic.Main.Views.Dashboard.SettingsPanel"
             x:DataType="vm:SettingsViewModel">

  <!-- The app-preference half of the Settings view (docs/ui-design.md §5,
       decision D3): Appearance, Logging, Defaults and About. It is composed into
       the Settings view's column, under the sections that configure the source,
       the inference server and engine and the operation rules. The Inference
       server section lives beside it in that view now (InferenceServerSection),
       so the server is still configured in one place.

       Every section is always in the tree (a single scrolling column, the form
       §5 allows for narrow windows): the layout audit walks this panel at every
       window size and must be able to measure each section, which a tab control
       would not allow. Rows wrap rather than clip - the window has no minimum
       width, so a dense row that only fits at 1280 is a row that loses its last
       control on a smaller screen. -->
  <StackPanel Spacing="12">

    <StackPanel Spacing="2" x:Name="AppPreferencesHeader">
      <TextBlock Text="App preferences" Classes="sectionTitle" />
      <TextBlock Classes="hint" TextWrapping="Wrap"
                 Text="Application-wide choices: appearance, logging, what a new session starts from, and this build's version and links." />
    </StackPanel>

    <!-- ── §5 · Appearance ──────────────────────────────────────────────── -->
    <Border Classes="card settingsCard settingsSection" x:Name="SectionAppearance"
            Padding="16" help:HelpScope.Topic="settings-reference.html">
      <StackPanel Spacing="8">
        <TextBlock Text="Appearance" Classes="sectionTitle" />

        <WrapPanel Classes="settingsRow">
          <TextBlock Classes="fieldLabel" Text="Theme:" Margin="0,0,8,8" />
          <ComboBox SelectedIndex="{Binding ThemeIndex}" ItemsSource="{Binding ThemeOptionList}"
                    MinWidth="140" Margin="0,0,12,8"
                    ToolTip.Tip="System follows the operating system's light/dark setting." />
          <TextBlock Classes="hint" VerticalAlignment="Center" Margin="0,0,0,8"
                     Text="Density is fixed: the same 2/4/8/12/16 rhythm everywhere." />
        </WrapPanel>
      </StackPanel>
    </Border>

    <!-- ── §5 · Logging ─────────────────────────────────────────────────── -->
    <Border Classes="card settingsCard settingsSection" x:Name="SectionLogging"
            Padding="16" help:HelpScope.Topic="step3-log.html">
      <StackPanel Spacing="8">
        <TextBlock Text="Logging" Classes="sectionTitle" />

        <WrapPanel Classes="settingsRow">
          <TextBlock Classes="fieldLabel" Text="Log level:" Margin="0,0,8,8" />
          <ComboBox SelectedIndex="{Binding LogLevelIndex}" ItemsSource="{Binding LogLevelOptionList}"
                    MinWidth="140" Margin="0,0,12,8"
                    ToolTip.Tip="Level shown in the in-app log view. The log file always keeps Debug and above, so a support question can still be answered afterwards." />
          <Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}"
                  Margin="0,0,12,8" />
          <CheckBox Content="Show diagnostics" IsChecked="{Binding ShowDiagnostics}"
                    VerticalAlignment="Center" Margin="0,0,0,8"
                    ToolTip.Tip="Show the in-app log view in the window. Off by default: an operation's run log lives in its processing view." />
        </WrapPanel>

        <TextBlock Classes="hint" TextWrapping="Wrap"
                   Text="{Binding LogFilePath, StringFormat='This run: {0}'}" />
      </StackPanel>
    </Border>

    <!-- ── §5 · Defaults ────────────────────────────────────────────────── -->
    <Border Classes="card settingsCard settingsSection" x:Name="SectionDefaults"
            Padding="16" help:HelpScope.Topic="settings-reference.html">
      <StackPanel Spacing="8">
        <TextBlock Text="Defaults" Classes="sectionTitle" />
        <TextBlock Classes="hint" TextWrapping="Wrap"
                   Text="What a new session starts from. Once a session has saved its own engine settings, those win - these are the first run's values, not an override of the current one." />

        <WrapPanel Classes="settingsRow">
          <TextBlock Classes="fieldLabel" Text="Device:" Margin="0,0,8,8" />
          <ComboBox SelectedIndex="{Binding DefaultDeviceIndex}"
                    ItemsSource="{Binding DefaultDeviceOptionList}" MinWidth="120"
                    Margin="0,0,12,8"
                    ToolTip.Tip="Compute device a new session starts on; the engine form can still change it per session." />
        </WrapPanel>

        <WrapPanel Classes="settingsRow">
          <TextBlock Classes="fieldLabel" Text="Tagging confidence:" Margin="0,0,8,8" />
          <NumericUpDown Value="{Binding DefaultConfidenceThreshold}" Minimum="0" Maximum="1"
                         Increment="0.05" FormatString="0.00" Width="120" Margin="0,0,12,8" />
          <TextBlock Classes="fieldLabel" Text="Max items:" Margin="0,0,8,8" />
          <NumericUpDown Value="{Binding DefaultMaxItems}" Minimum="0" Maximum="1000000"
                         Increment="50" Width="120" Margin="0,0,12,8" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <!-- ── §5 · About ───────────────────────────────────────────────────── -->
    <Border Classes="card settingsCard settingsSection" x:Name="SectionAbout"
            Padding="16" help:HelpScope.Topic="index.html">
      <StackPanel Spacing="8">
        <TextBlock Text="About" Classes="sectionTitle" />

        <WrapPanel>
          <TextBlock Text="{Binding VersionText, StringFormat='Synapic {0}'}"
                     VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,8" />
          <Button Content="Help home" Command="{Binding Shell.OpenHelpCommand}"
                  Margin="0,0,8,8"
                  ToolTip.Tip="The help's home page. F1 opens the topic for what you are looking at." />
          <Button Content="Repository" Command="{Binding OpenRepositoryCommand}"
                  Margin="0,0,8,8"
                  ToolTip.Tip="The project's source and releases, on GitHub." />
        </WrapPanel>

        <TextBlock Classes="hint" TextWrapping="Wrap"
                   Text="{Binding ConfigFilePath, StringFormat='Settings file: {0}'}" />
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
