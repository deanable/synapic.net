<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Synapic.Main.ViewModels"
             xmlns:dash="using:Synapic.Main.Views.Dashboard"
             xmlns:help="using:Synapic.Main.Services"
             x:Class="Synapic.Main.Views.Dashboard.DashboardView"
             x:DataType="vm:MainWindowViewModel">

  <!-- The dashboard (docs/ui-design.md §2.1/§3/§7, decisions D1/D2/D3/D8): the
       app's starting screen — a 2x2 grid of four panels, Settings + the three
       operations, each opening its view. Entering an operation is free (D6): only
       a run is gated, and the gate is stated in the region that is blocked, so
       the dashboard is never a dead end. Every status line here reads shared
       state and nothing is invented: the record count comes from the one source,
       the server state from the sidecar.

       The grid is two columns while every panel keeps DashboardView.MinPanelWidth
       (600 px) of width, and stacks into one full-width reading-order column
       below that — §7's responsive rule with the switch point the design leaves
       to the implementation, recorded as D8. The panels are placed by explicit
       Grid.Row/Grid.Column rather than by a UniformGrid, because a UniformGrid
       gives every cell the height of its tallest child and the Settings panel
       still hosts the §5 settings form inline: that form would have made the
       three operation cards exactly as tall as it is.

       Avalonia has no XAML breakpoint, so the form is DashboardView's own job
       (DashboardView.axaml.cs): it moves the four panels between the grid cells
       when its own width crosses the threshold, and the layout audit pins both
       forms and asserts the rule rather than today's geometry. -->
  <StackPanel Spacing="16" Margin="0,20,0,20" help:HelpScope.Topic="workflow-overview.html">

    <StackPanel HorizontalAlignment="Center" Spacing="6">
      <TextBlock Text="Set up a workflow" FontSize="22" FontWeight="SemiBold"
                 HorizontalAlignment="Center" />
      <TextBlock Text="1 connect a source and pick the model, 2 choose the operation, 3 tune its settings — then run it."
                 Opacity="0.7" HorizontalAlignment="Center" TextWrapping="Wrap" />
    </StackPanel>

    <!-- ── The four panels, in reading order: Settings, Tag, Dedup, Upscale ─────
         The XAML is the two-column form; the code-behind stacks it when the
         dashboard is too narrow for it. Row 0 carries the first two panels and
         row 1 the last two, and the two spare Auto rows stay empty until the
         stacked form uses them. -->
    <Grid x:Name="PanelGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto">

      <!-- Panel 1 · Settings ────────────────────────────────────────────────
           The app-wide settings view (docs/ui-design.md §5): inference server,
           appearance, logging, defaults, about. It is the one home for app-level
           settings (D3) - the source and the model that used to sit here were the
           Phase 2 placeholder, and they live where the design puts them now: the
           shared source in every operation's Data source region (one source for
           every mode, D4) and the model picker on Tagging's Parameters region. -->
      <Border Grid.Row="0" Grid.Column="0" Classes="card settingsCard dashboardPanel"
              x:Name="SettingsPanel" Padding="16" Margin="4"
              help:HelpScope.Topic="settings-reference.html">
        <dash:SettingsPanel DataContext="{Binding AppSettings}" />
      </Border>

      <!-- Panels 2–4 · the three operations ─────────────────────────────────
           One accent action per panel, and it is the panel: the whole card opens
           the operation through the same route command the header's Dashboard
           entry comes back from, so there is one entry point per operation in
           each place. The status line is the shared record count, or the neutral
           hint until a source exists — never a number nobody can back up. -->
      <Border Grid.Row="0" Grid.Column="1" Classes="card settingsCard dashboardPanel"
              x:Name="TagPanel" Padding="8" Margin="4">
        <Button Classes="routeCard" Command="{Binding StartTaggingRouteCommand}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                help:HelpScope.Topic="workflow-overview.html"
                ToolTip.Tip="Open Tagging: run the AI model over the shared source">
          <StackPanel Spacing="6" Margin="6">
            <TextBlock Text="🏷  Tagging" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Run the AI model over a datasource: check the source and the model, tune the tagging settings, process the batch, then review what was written."
                       TextWrapping="Wrap" Opacity="0.85" />
            <TextBlock Text="{Binding SourceCountText}" Opacity="0.55" FontSize="12"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Button>
      </Border>

      <Border Grid.Row="1" Grid.Column="0" Classes="card settingsCard dashboardPanel"
              x:Name="DedupPanel" Padding="8" Margin="4">
        <Button Classes="routeCard" Command="{Binding StartDedupRouteCommand}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                help:HelpScope.Topic="dedup.html"
                ToolTip.Tip="Open Deduplication: scan the shared source for duplicate groups">
          <StackPanel Spacing="6" Margin="6">
            <TextBlock Text="🧹  Deduplication" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Find duplicate images in a local folder or in the Daminion catalog scope, review the groups, then tag, move or delete the extras."
                       TextWrapping="Wrap" Opacity="0.85" />
            <TextBlock Text="{Binding SourceCountText}" Opacity="0.55" FontSize="12"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Button>
      </Border>

      <Border Grid.Row="1" Grid.Column="1" Classes="card settingsCard dashboardPanel"
              x:Name="UpscalePanel" Padding="8" Margin="4">
        <Button Classes="routeCard" Command="{Binding StartUpscaleRouteCommand}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                help:HelpScope.Topic="upscale.html"
                ToolTip.Tip="Open Upscaling: enhance the resolution of the shared source">
          <StackPanel Spacing="6" Margin="6">
            <TextBlock Text="✨  Upscaling" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Enhance image resolution — the Daminion Feature enhancement utility: AI (Swin2SR) or fast Lanczos upscaling over the chosen source."
                       TextWrapping="Wrap" Opacity="0.85" />
            <TextBlock Text="{Binding SourceCountText}" Opacity="0.55" FontSize="12"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Button>
      </Border>

    </Grid>
  </StackPanel>
</UserControl>
