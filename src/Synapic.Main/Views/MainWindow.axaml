<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Synapic.Main.Views"
        xmlns:vm="using:Synapic.Main.ViewModels"
        x:Class="Synapic.Main.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Synapic — AI Image Tagging"
        Icon="/Assets/Icon.ico"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen">

  <!-- The shell (header / sidebar / content / footer) lives in MainLayout so the
       window only carries window-level behaviour: F1 help resolution, Alt+Home,
       Ctrl+S and log teardown. -->
  <views:MainLayout x:Name="Layout" />

</Window>
